---
/**
 * Site header: logo + breadcrumb, nav pill (wide), search / theme buttons,
 * a ☰ dropdown (narrow), and the ⌘K command palette. All client behaviour
 * lives in the client script below; layout switches with media queries.
 */
interface NavItem {
	label: string;
	url: string;
}

interface Props {
	nav: NavItem[];
	email?: string;
	github?: string;
	linkedin?: string;
	latestPost?: { title: string; url: string };
}

const { nav, email, github, linkedin, latestPost } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const crumb = path === "/" ? "" : path;

const isCurrent = (url: string) =>
	url === "/" ? path === "/" : path === url || path.startsWith(`${url}/`);
const navPath = (url: string) => (url === "/" ? "~/" : `~${url}`);
const shortcut = (label: string) => label.charAt(0).toLowerCase();
// `g g` scrolls to the top, vim-style, unless a nav label claims `g`.
const ggFree = !nav.some((n) => shortcut(n.label) === "g");

type Command = { label: string; hint: string; href?: string; action?: string };
const commands: Command[] = [
	...nav.map((n) => ({
		label: `Go to ${n.label.toLowerCase()}`,
		hint: `g ${shortcut(n.label)}`,
		href: n.url,
	})),
	...(latestPost ? [{ label: `Read: ${latestPost.title}`, hint: "post", href: latestPost.url }] : []),
	{ label: "Toggle light / dark", hint: "t", action: "theme" },
	{ label: "Back to top", hint: ggFree ? "g g" : "↑", action: "top" },
	{ label: "set motion=off", hint: "calm", action: "motion-off" },
	{ label: "set motion=on", hint: "lively", action: "motion-on" },
	...(email ? [{ label: "Copy email address", hint: "mail", action: "copy-email" }] : []),
	...(github ? [{ label: "Open GitHub", hint: "↗", href: github, action: "external" }] : []),
];
---

<header class="site-header" data-email={email} data-gg={ggFree ? "" : undefined}>
	<div class="bar">
		<a href="/" class="brand">
			<span class="badge">TS</span>
			<span class="brand-path">
				<span class="roll">
					<span class="roll-a">~/thijmen<span class="crumb">{crumb}</span></span>
					<span class="roll-b" aria-hidden="true">cd ~</span>
				</span>
			</span>
		</a>

		<nav class="nav-pill" aria-label="Primary">
			<span class="nav-glide" aria-hidden="true"></span>
			{
				nav.map((n) => (
					<a
						href={n.url}
						class:list={["nav-link", { current: isCurrent(n.url) }]}
						aria-current={isCurrent(n.url) ? "page" : undefined}
						data-key={shortcut(n.label)}
					>
						{n.label}
					</a>
				))
			}
		</nav>

		<div class="actions">
			<button type="button" class="btn-search" data-open-palette aria-label="Search">
				<span class="wide-only">search </span>⌘K
			</button>
			<button type="button" class="btn-theme" data-toggle-theme aria-label="Toggle theme" title="Toggle theme (t)">
				◐<span class="wide-only theme-label"> light</span>
			</button>
			<button type="button" class="btn-menu" data-toggle-menu aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
				<span class="icon-open">☰</span><span class="icon-close">✕</span>
			</button>
		</div>
	</div>

	<div class="menu" id="mobile-menu" hidden>
		<nav class="menu-inner" aria-label="Primary">
			{
				nav.map((n, i) => (
					<a href={n.url} class:list={["menu-link", { current: isCurrent(n.url) }]} style={`--i:${i}`}>
						<span>{n.label}</span>
						<span class="menu-path">{navPath(n.url)}</span>
					</a>
				))
			}
			<div class="menu-social">
				{github && <a href={github}>github(1)</a>}
				{linkedin && <a href={linkedin}>linkedin(1)</a>}
				{email && <a href={`mailto:${email}`}>mailto(2)</a>}
			</div>
		</nav>
	</div>

	<div class="palette" hidden data-palette>
		<div class="palette-box" role="dialog" aria-modal="true" aria-label="Command palette">
			<div class="palette-input">
				<span class="prompt">&gt;</span>
				<input type="text" placeholder="type a command…" autocomplete="off" spellcheck="false" aria-label="Command" />
				<span class="kbd">esc</span>
			</div>
			<div class="palette-list" role="listbox">
				{
					commands.map((c) => (
						<button
							type="button"
							class="cmd"
							role="option"
							data-label={c.label.toLowerCase()}
							data-href={c.href}
							data-action={c.action}
						>
							<span>{c.label}</span>
							<span class="cmd-hint">{c.hint}</span>
						</button>
					))
				}
				<div class="palette-empty" hidden>command not found: <span></span></div>
			</div>
			<div class="palette-foot">
				<span>↑↓ select</span><span>↵ run</span><span>t theme</span><span>g+b blog</span>
			</div>
		</div>
	</div>

	<button type="button" class="to-top" data-to-top aria-label={ggFree ? "Back to top (g g)" : "Back to top"}>
		↑ {ggFree ? "gg" : "top"}
	</button>
</header>

<script>
	import { applyMotionPref } from "../scripts/motion";

	const root = document.documentElement;
	const header = document.querySelector<HTMLElement>(".site-header")!;
	const themeLabel = header.querySelector<HTMLElement>(".theme-label")!;
	const menu = header.querySelector<HTMLElement>("#mobile-menu")!;
	const menuBtn = header.querySelector<HTMLButtonElement>("[data-toggle-menu]")!;
	const palette = header.querySelector<HTMLElement>("[data-palette]")!;
	const input = palette.querySelector<HTMLInputElement>("input")!;
	const cmds = [...palette.querySelectorAll<HTMLButtonElement>(".cmd")];
	const empty = palette.querySelector<HTMLElement>(".palette-empty")!;
	const navKeys = [...header.querySelectorAll<HTMLAnchorElement>(".nav-link")];
	const brand = header.querySelector<HTMLAnchorElement>(".brand")!;
	const toTopBtn = header.querySelector<HTMLButtonElement>("[data-to-top]")!;
	const ggFree = header.hasAttribute("data-gg");
	const full = () => root.dataset.motion === "full";

	// Theme ------------------------------------------------------------
	const currentTheme = () =>
		root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
	const syncThemeLabel = () => (themeLabel.textContent = ` ${currentTheme()}`);
	/**
	 * Swap the theme. With full motion and View Transitions the new theme
	 * grows as a circle from `origin` (the toggle; the viewport centre for
	 * `t` and the palette). Otherwise the body's colour fade does the job.
	 */
	function toggleTheme(origin?: { x: number; y: number }) {
		const next = currentTheme() === "light" ? "dark" : "light";
		const apply = () => {
			root.dataset.theme = next;
			try {
				localStorage.setItem("ts-theme", next);
			} catch {}
			syncThemeLabel();
		};
		if (!document.startViewTransition || !full()) return apply();
		const { x, y } = origin ?? { x: innerWidth / 2, y: innerHeight / 2 };
		const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
		// Freezes transitions so the new snapshot already has the new colours.
		root.classList.add("theme-vt");
		const vt = document.startViewTransition(apply);
		vt.ready
			.then(() =>
				root.animate(
					{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
					{ duration: 560, easing: "cubic-bezier(0.16, 1, 0.3, 1)", pseudoElement: "::view-transition-new(root)" },
				),
			)
			.catch(() => {});
		vt.finished.finally(() => root.classList.remove("theme-vt"));
	}
	syncThemeLabel();
	header.querySelector("[data-toggle-theme]")!.addEventListener("click", (e) => {
		const b = (e.currentTarget as HTMLElement).getBoundingClientRect();
		toggleTheme({ x: b.left + b.width / 2, y: b.top + b.height / 2 });
	});

	// Sticky header ----------------------------------------------------
	// Sticks and condenses into a floating pill past 80px. Its height never
	// changes, so nothing below moves; --header-offset feeds scroll-padding.
	header.classList.add("js-sticky");
	const syncOffset = () => root.style.setProperty("--header-offset", `${header.offsetHeight}px`);
	new ResizeObserver(syncOffset).observe(header);
	let condensed: boolean | undefined;
	let showTop: boolean | undefined;
	let ticking = false;
	function onScroll() {
		ticking = false;
		const y = scrollY;
		if (condensed !== y > 80) header.classList.toggle("condensed", (condensed = y > 80));
		if (showTop !== y > innerHeight) toTopBtn.classList.toggle("show", (showTop = y > innerHeight));
	}
	addEventListener(
		"scroll",
		() => {
			if (!ticking) requestAnimationFrame(onScroll);
			ticking = true;
		},
		{ passive: true },
	);
	onScroll();
	// Transitions only after the first placement: a reload halfway down
	// the page starts condensed instead of animating into it.
	requestAnimationFrame(() => requestAnimationFrame(() => header.classList.add("header-ready")));

	function toTop() {
		scrollTo({ top: 0, behavior: full() ? "smooth" : "auto" });
		// The button hides at the top; keep focus somewhere sensible.
		brand.focus({ preventScroll: true });
	}
	toTopBtn.addEventListener("click", toTop);

	// Nav glide --------------------------------------------------------
	// One highlight that slides to the hovered or focused link and back
	// to the current page's link.
	const pill = header.querySelector<HTMLElement>(".nav-pill")!;
	const glide = pill.querySelector<HTMLElement>(".nav-glide")!;
	const current = navKeys.find((a) => a.classList.contains("current"));
	let target: HTMLElement | undefined;
	function glideTo(link: HTMLElement | undefined, jump = false) {
		target = link;
		if (!link || !link.offsetWidth) return glide.classList.remove("on");
		// Appearing from nothing (or re-measuring): place it, don't slide.
		jump ||= !glide.classList.contains("on");
		if (jump) glide.style.transition = "none";
		glide.style.setProperty("--x", `${link.offsetLeft}px`);
		glide.style.setProperty("--y", `${link.offsetTop}px`);
		glide.style.setProperty("--w", `${link.offsetWidth}px`);
		glide.style.setProperty("--h", `${link.offsetHeight}px`);
		if (jump) {
			void glide.offsetWidth;
			glide.style.transition = "";
		}
		glide.classList.add("on");
	}
	pill.classList.add("has-glide");
	navKeys.forEach((a) => {
		a.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && glideTo(a));
		a.addEventListener("focus", () => glideTo(a));
	});
	pill.addEventListener("pointerleave", () => glideTo(current));
	pill.addEventListener("focusout", (e) => !pill.contains(e.relatedTarget as Node) && glideTo(current));
	// Font swaps, breakpoints and the pill hiding below 760px.
	new ResizeObserver(() => glideTo(target, true)).observe(pill);
	document.fonts?.ready.then(() => glideTo(target, true));
	glideTo(current, true);

	// Mobile menu ------------------------------------------------------
	function setMenu(open: boolean) {
		menu.hidden = !open;
		menuBtn.setAttribute("aria-expanded", String(open));
		header.classList.toggle("menu-open", open);
	}
	menuBtn.addEventListener("click", () => setMenu(Boolean(menu.hidden)));
	matchMedia("(min-width: 760px)").addEventListener("change", (e) => e.matches && setMenu(false));

	// Command palette --------------------------------------------------
	let sel = 0;
	const visible = () => cmds.filter((c) => !c.hidden);
	function render() {
		const q = input.value.trim().toLowerCase();
		cmds.forEach((c) => (c.hidden = !c.dataset.label!.includes(q)));
		const list = visible();
		sel = Math.min(sel, Math.max(list.length - 1, 0));
		list.forEach((c, i) => c.classList.toggle("selected", i === sel));
		empty.hidden = list.length > 0;
		empty.querySelector("span")!.textContent = input.value;
	}
	let opener: HTMLElement | null = null;
	function openPalette() {
		setMenu(false);
		opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
		palette.hidden = false;
		input.value = "";
		sel = 0;
		render();
		input.focus();
	}
	function closePalette() {
		const hadFocus = palette.contains(document.activeElement);
		palette.hidden = true;
		// Back to whatever opened it (the palette fades out for a moment).
		if (hadFocus && opener?.isConnected) opener.focus({ preventScroll: true });
	}
	function run(cmd: HTMLButtonElement) {
		const { href, action } = cmd.dataset;
		if (action === "theme") {
			// Close first so the theme reveal doesn't capture a half-open palette.
			palette.hidden = true;
			toggleTheme();
		} else if (action === "top") toTop();
		else if (action === "motion-off" || action === "motion-on") applyMotionPref(action === "motion-off" ? "off" : "on");
		else if (action === "copy-email") navigator.clipboard?.writeText(header.dataset.email ?? "").catch(() => {});
		else if (action === "external" && href) window.open(href, "_blank", "noopener");
		else if (href) location.href = href;
		closePalette();
	}

	header.querySelectorAll("[data-open-palette]").forEach((b) => b.addEventListener("click", openPalette));
	palette.addEventListener("click", (e) => e.target === palette && closePalette());
	input.addEventListener("input", () => {
		sel = 0;
		render();
	});
	cmds.forEach((c) => {
		c.addEventListener("click", () => run(c));
		c.addEventListener("mouseenter", () => {
			sel = visible().indexOf(c);
			render();
		});
	});

	// Keyboard ---------------------------------------------------------
	let gAt = 0;
	window.addEventListener("keydown", (e) => {
		const t = e.target as HTMLElement;
		const typing = ["input", "textarea", "select"].includes(t.tagName?.toLowerCase()) || t.isContentEditable;

		if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
			e.preventDefault();
			palette.hidden ? openPalette() : closePalette();
			return;
		}
		if (!palette.hidden) {
			const list = visible();
			if (e.key === "Escape") closePalette();
			else if (e.key === "ArrowDown") {
				e.preventDefault();
				sel = Math.min(sel + 1, list.length - 1);
				render();
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				sel = Math.max(sel - 1, 0);
				render();
			} else if (e.key === "Enter" && list[sel]) {
				e.preventDefault();
				run(list[sel]);
			}
			return;
		}
		if (e.key === "Escape") setMenu(false);
		if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
		if (e.key === "/") {
			e.preventDefault();
			openPalette();
		} else if (e.key === "t") toggleTheme();
		else if (e.key === "g") {
			if (ggFree && Date.now() - gAt < 900) {
				gAt = 0;
				toTop();
			} else gAt = Date.now();
		} else if (Date.now() - gAt < 900) {
			const link = navKeys.find((a) => a.dataset.key === e.key);
			if (link) location.href = link.href;
		}
	});
</script>

<style>
	/*
	 * Never give .site-header a transform, filter, backdrop-filter or
	 * will-change: it holds the fixed palette and back-to-top button, and
	 * any of those would make it their containing block.
	 */
	.site-header {
		position: relative;
		z-index: 30;
		font-size: 14px;
		color: var(--color-text);
	}

	/* Sticky once the script runs. The strip around the pill lets clicks through. */
	.js-sticky {
		position: sticky;
		top: 0;
		pointer-events: none;
	}

	.js-sticky .bar > *,
	.js-sticky .menu,
	.js-sticky .palette,
	.js-sticky .to-top {
		pointer-events: auto;
	}

	.bar {
		position: relative;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 20px var(--gutter);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 14px 20px;
		align-items: center;
	}

	/* The floating pill behind the condensed bar. */
	.bar::before {
		content: "";
		position: absolute;
		inset: 12px 0;
		z-index: -1;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: color-mix(in oklch, var(--color-bg) 76%, transparent);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		backdrop-filter: blur(14px) saturate(1.4);
		opacity: 0;
		pointer-events: none;
	}

	.condensed .bar {
		max-width: min(var(--header-pill-w, 940px), 100% - 24px);
		padding-inline: 22px 14px;
	}

	.condensed .bar::before {
		opacity: 1;
	}

	.condensed .brand {
		gap: 0;
	}

	.condensed .brand-path {
		max-width: 0;
		opacity: 0;
	}

	.condensed .nav-pill {
		border-color: transparent;
		background: transparent;
	}

	.condensed .wide-only {
		display: none;
	}

	.header-ready .bar {
		transition:
			max-width var(--dur-header) var(--ease-out),
			padding var(--dur-header) var(--ease-out);
	}

	.header-ready .bar::before {
		transition: opacity var(--dur-header) var(--ease-out);
	}

	.header-ready .brand,
	.header-ready .brand-path,
	.header-ready .nav-pill {
		transition:
			gap var(--dur-header) var(--ease-out),
			max-width var(--dur-header) var(--ease-out),
			opacity var(--dur-header) var(--ease-out),
			border-color var(--dur-header),
			background-color var(--dur-header);
	}

	@media (prefers-reduced-transparency: reduce) {
		.bar::before {
			background: var(--color-bg);
			backdrop-filter: none;
		}
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
		justify-self: start;
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 13px;
		text-decoration: none;
	}

	.brand:hover {
		text-decoration: none;
	}

	.badge {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: var(--radius-sm);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 11px;
		font-weight: 700;
	}

	.brand-path {
		min-width: 0;
		max-width: 100%;
		overflow: hidden;
	}

	/* Logo roll: hovering `~/thijmen/…` rolls it up to `cd ~`. */
	.roll {
		display: grid;
	}

	.roll > * {
		grid-area: 1 / 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.roll-b {
		translate: 0 110%;
	}

	@media (hover: hover) and (pointer: fine) {
		:global(:root[data-motion="full"]) .roll > * {
			transition: translate 300ms var(--ease-in-out);
		}

		:global(:root[data-motion="full"]) .brand:is(:hover, :focus-visible) .roll-a {
			translate: 0 -110%;
		}

		:global(:root[data-motion="full"]) .brand:is(:hover, :focus-visible) .roll-b {
			translate: 0 0;
		}
	}

	.crumb {
		color: var(--color-brand);
	}

	.nav-pill {
		position: relative;
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 5px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-bg);
	}

	.nav-link {
		position: relative;
		padding: 7px 14px;
		border-radius: var(--radius-pill);
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
	}

	/* Sliding highlight, positioned by the script. */
	.nav-glide {
		position: absolute;
		top: 0;
		left: 0;
		width: var(--w, 0);
		height: var(--h, 0);
		translate: var(--x, 0) var(--y, 0);
		border-radius: var(--radius-pill);
		background: var(--color-brand-soft);
		opacity: 0;
		transition:
			translate var(--dur-move) var(--ease-out),
			width var(--dur-move) var(--ease-out),
			opacity var(--dur-fast);
	}

	.nav-glide.on {
		opacity: 1;
	}

	.has-glide .nav-link:hover,
	.has-glide .nav-link.current {
		background: transparent;
	}

	.nav-link:hover {
		background: var(--color-brand-soft);
		text-decoration: none;
	}

	.nav-link.current {
		background: var(--color-brand-soft);
		color: var(--color-brand);
	}

	.actions {
		grid-column: 3;
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.actions button {
		font: inherit;
		min-height: 34px;
		padding: 7px 12px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-border);
		cursor: pointer;
		white-space: nowrap;
		transition: border-color var(--transition-fast);
	}

	.actions button:hover {
		border-color: var(--color-brand);
	}

	.btn-search {
		background: var(--color-bg);
		color: var(--color-muted);
	}

	.btn-theme {
		min-width: 34px;
		background: var(--color-surface);
		color: var(--color-text);
	}

	.actions .btn-menu {
		display: none;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-size: 16px;
	}

	.icon-close,
	.menu-open .icon-open {
		display: none;
	}

	.menu-open .icon-close {
		display: inline;
	}

	.menu-open .btn-menu {
		background: var(--color-brand-soft);
	}

	/* Dropdown menu (narrow screens) */
	.menu {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		z-index: 20;
		padding: 0 clamp(16px, 5vw, 64px);
	}

	/*
	 * Menu and palette animate in and out around the `hidden` toggle:
	 * @starting-style for the way in, `display … allow-discrete` keeps them
	 * on screen for the way out (a transition outranks [hidden]'s
