---
/** A photo filling the whole tile, with its caption as a chip. Colour on the page comes from art like this. */
import { Image } from "emdash/ui";
import { hasImage } from "../../lib/content";
import HomeTile from "./HomeTile.astro";

interface Props {
	value: {
		image: unknown;
		caption?: string | null;
		url?: string | null;
		size?: string | null;
		tall?: boolean | null;
	};
}

const { value: v } = Astro.props;
---

{
	hasImage(v.image) && (
		<HomeTile size={v.size} fallbackSize="third" tall={v.tall} href={v.url} class="photo">
			<Image image={v.image as any} class="cover-img" />
			{v.caption && <span class="caption">{v.caption}</span>}
		</HomeTile>
	)
}

<style>
	/* .photo sits on HomeTile's root, outside this component's scope. */
	:global(.home-tile.photo) {
		min-height: 280px;
		justify-content: flex-end;
		background: var(--color-surface);
	}

	:global(.home-tile.photo) :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Only the ↗ sits in the label row; it floats over the photo. */
	:global(.home-tile.photo > .tile-label) {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 1;
	}

	.caption {
		position: relative;
		z-index: 1;
		align-self: flex-start;
		max-width: 100%;
		margin: 0 -14px -14px;
		padding: 7px 12px;
		border-radius: var(--radius-pill);
		background: var(--color-tile);
		color: var(--color-text);
		font-size: 13px;
		font-weight: 500;
		line-height: 1.2;
	}
</style>
