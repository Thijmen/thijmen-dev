---
/**
 * Portable Text `code` block: terminal-window chrome with the filename,
 * a copy button, a line-number gutter and Shiki highlighting through the
 * css-variables theme (token colours map to --syntax-* in tokens.css).
 * `mermaid` code renders as a diagram instead (Diagram.astro), or as plain
 * code when it can't be drawn.
 */
import { renderDiagram } from "../../lib/diagram";
import { highlight } from "../../lib/highlight";
import Diagram from "../Diagram.astro";
import Window from "../Window.astro";

const { node } = Astro.props as { node: { code?: string; language?: string; filename?: string; caption?: string } };
const code = (node.code ?? "").replace(/\n+$/, "");
const lines = code.split("\n").length;
const svg = node.language?.toLowerCase() === "mermaid" ? renderDiagram(code) : null;
const html = code && !svg ? await highlight(code, node.language) : null;
---

{svg && <Diagram svg={svg} title={node.filename} caption={node.caption} />}
{
	code && !svg && (
		<Window title={node.filename || node.language || "snippet"} class="code-window" data-print style={`--lines:${lines}`}>
			<button type="button" class="copy" slot="aside" data-copy>copy</button>
			<div class="code-body">
				<div class="gutter" aria-hidden="true">
					{Array.from({ length: lines }, (_, i) => (
						<span style={`--line:${i}`}>{i + 1}</span>
					))}
				</div>
				{/* Unhighlighted fallback: same .line spans, so it prints in too. Kept on one line: whitespace in <pre> is content. */}
				{html ? <Fragment set:html={html} /> : <pre class="shiki"><code>{code.split("\n").map((l, i) => <><span class="line" style={`--line:${i}`}>{l}</span>{i < lines - 1 && "\n"}</>)}</code></pre>}
			</div>
		</Window>
	)
}

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const code = btn.closest(".code-window")?.querySelector("pre")?.textContent ?? "";
			navigator.clipboard?.writeText(code).catch(() => {});
			btn.textContent = "copied ✓";
			setTimeout(() => (btn.textContent = "copy"), 1400);
		});
	});
</script>

<style>
	:global(.code-window) {
		margin: 6px 0;
		font-size: 13.5px;
		line-height: 1.75;
		border-radius: var(--radius-md);
	}

	:global(.code-window .window-bar) {
		padding: 12px 18px;
		background: transparent;
		border-bottom: 1px solid var(--dark-tile-2);
	}

	:global(.code-window .window-title) {
		font-size: 12.5px;
		font-weight: 500;
	}

	.copy {
		font: inherit;
		font-size: 12px;
		padding: 3px 8px;
		margin: -3px -8px;
		border: 0;
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--dark-ink-2);
		cursor: pointer;
		transition: color var(--dur-fast);
	}

	.copy:hover {
		color: var(--dark-ink);
	}

	.code-body {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr);
		padding: 14px 0;
	}

	.gutter {
		display: flex;
		flex-direction: column;
		padding-right: 18px;
		text-align: right;
		color: oklch(0.5 0.03 292);
		user-select: none;
	}

	.code-body :global(pre.shiki) {
		margin: 0;
		padding: 0 18px 0 0;
		overflow-x: auto;
		background: transparent !important;
		color: var(--dark-ink);
		font: inherit;
		--shiki-foreground: var(--dark-ink);
		--shiki-background: transparent;
		--shiki-token-keyword: var(--syntax-keyword);
		--shiki-token-string: var(--syntax-string);
		--shiki-token-string-expression: var(--syntax-string);
		--shiki-token-function: var(--syntax-fn);
		--shiki-token-constant: var(--syntax-number);
		--shiki-token-comment: var(--syntax-comment);
		--shiki-token-parameter: var(--dark-ink);
		--shiki-token-punctuation: var(--dark-ink);
		--shiki-token-link: var(--syntax-keyword);
	}

	.code-body :global(code) {
		font-family: var(--font-mono);
	}
</style>
