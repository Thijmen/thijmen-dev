---
/**
 * Blockquotes in post bodies render as the design's NOTE callout. EmDash
 * groups runs of blockquote blocks into one `blockquoteGroup` node (passed as
 * `node`); a single blockquote comes through Block.astro as slotted content.
 */
import { PortableText } from "emdash/ui";

const { node } = Astro.props as { node?: { blocks?: Array<Record<string, unknown>> } };
const paragraphs = (node?.blocks ?? []).map((b) => ({ ...b, style: "normal" }));
---

<aside class="note">
	<span class="note-label">Note</span>
	<div class="note-body">{node ? <PortableText value={paragraphs as any} /> : <p><slot /></p>}</div>
</aside>

<style>
	.note {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 12px 0;
		padding: 22px 26px;
		border-radius: var(--radius-md);
		background: var(--color-brand-soft);
	}

	.note-label {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 600;
		line-height: 1;
		color: var(--color-brand);
	}

	.note-body {
		font-size: 18.5px;
		line-height: 1.55;
		text-wrap: pretty;
	}

	.note-body :global(p) {
		margin: 0;
	}
</style>
