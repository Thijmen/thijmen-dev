---
/**
 * Local time in the author's city. Filled in by the script, because pages
 * are cached for an hour: a server-stamped time would be stale. Without JS
 * the tile shows only the city. The daylight bar uses the standard
 * sunrise equation, so it needs no API.
 */

interface Props {
	city?: string;
	zone?: string;
	lat?: number;
	lng?: number;
}

const { city = "Amsterdam", zone = "Europe/Amsterdam", lat = 52.37, lng = 4.9 } = Astro.props;
---

<section class="tile time" data-local-time data-zone={zone} data-lat={lat} data-lng={lng} data-reveal>
	<div class="tile-label">Local time</div>
	<div class="big-num clock" data-clock>&nbsp;</div>
	<div class="city">{city}<span data-tz-wrap hidden> · <span data-tz></span></span></div>
	<div class="rel" data-rel></div>
	<div class="day" aria-hidden="true" hidden data-day>
		<div class="track">
			<i class="daylight" data-daylight></i>
			<i class="nowmark" data-now></i>
		</div>
		<div class="dl"><span data-rise></span><span data-set></span></div>
	</div>
</section>

<script>
	function init(root: HTMLElement) {
		const TZ = root.dataset.zone!;
		const LAT = Number(root.dataset.lat);
		const LNG = Number(root.dataset.lng);
		const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const parts = (d: Date, opts: Intl.DateTimeFormatOptions) =>
			Object.fromEntries(new Intl.DateTimeFormat("en-GB", { timeZone: TZ, ...opts }).formatToParts(d).map((p) => [p.type, p.value]));
		const hm = (d: Date) => {
			const p = parts(d, { hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
			return `${p.hour}:${p.minute}`;
		};
		const mins = (d: Date) => {
			const [h, m] = hm(d).split(":").map(Number);
			return h * 60 + m;
		};
		/** The zone's UTC offset in minutes. */
		const offset = (d: Date) => {
			const p = parts(d, { year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
			return Math.round((Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute) - Math.floor(d.getTime() / 60000) * 60000) / 60000);
		};
		const rad = Math.PI / 180;
		const pct = (m: number) => `${(m / 1440) * 100}%`;

		function tick() {
			const now = new Date();
			q("[data-clock]").textContent = hm(now);
			q("[data-tz]").textContent = parts(now, { timeZoneName: "short" }).timeZoneName ?? "";
			q("[data-tz-wrap]").hidden = false;

			const diff = offset(now) + now.getTimezoneOffset();
			const h = Math.abs(diff) / 60;
			const hs = Number.isInteger(h) ? `${h}h` : `${h.toFixed(1)}h`;
			q("[data-rel]").textContent = diff === 0 ? "same clock as yours" : diff > 0 ? `${hs} ahead of you` : `${hs} behind you`;

			// Sunrise and sunset from the sunrise equation.
			const J = Math.round(now.getTime() / 86400000 + 2440587.5 - 2451545 + 0.0008) - LNG / 360;
			const M = (357.5291 + 0.98560028 * J) % 360;
			const C = 1.9148 * Math.sin(M * rad) + 0.02 * Math.sin(2 * M * rad) + 0.0003 * Math.sin(3 * M * rad);
			const L = (M + C + 282.9372) % 360;
			const Jt = 2451545 + J + 0.0053 * Math.sin(M * rad) - 0.0069 * Math.sin(2 * L * rad);
			const dec = Math.asin(Math.sin(L * rad) * Math.sin(23.4397 * rad));
			const cosW = (Math.sin(-0.833 * rad) - Math.sin(LAT * rad) * Math.sin(dec)) / (Math.cos(LAT * rad) * Math.cos(dec));
			if (cosW > -1 && cosW < 1) {
				const w = Math.acos(cosW) / rad;
				const fromJ = (j: number) => new Date((j - 2440587.5) * 86400000);
				const rise = fromJ(Jt - w / 360);
				const set = fromJ(Jt + w / 360);
				q("[data-rise]").textContent = `↑${hm(rise)}`;
				q("[data-rise]").style.left = pct(mins(rise));
				q("[data-set]").textContent = `↓${hm(set)}`;
				q("[data-set]").style.left = pct(mins(set));
				q("[data-daylight]").style.left = pct(mins(rise));
				q("[data-daylight]").style.width = pct(mins(set) - mins(rise));
				q("[data-now]").style.left = pct(mins(now));
				q("[data-day]").hidden = false;
			}
		}
		tick();
		// Align to the minute, then tick every minute (not every second).
		setTimeout(() => {
			tick();
			setInterval(tick, 60_000);
		}, 60_000 - (Date.now() % 60_000));
	}
	document.querySelectorAll<HTMLElement>("[data-local-time]").forEach(init);
</script>

<style>
	.clock {
		margin-top: 10px;
	}

	.city {
		margin-top: 10px;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.rel {
		margin-top: 3px;
		min-height: 1.5em;
		font-size: 13.5px;
		color: var(--color-muted);
	}

	.day {
		margin-top: auto;
	}

	.track {
		position: relative;
		height: 6px;
		border-radius: 3px;
		background: var(--color-surface);
	}

	.daylight {
		position: absolute;
		top: 0;
		bottom: 0;
		border-radius: 3px;
		background: var(--color-brand-soft);
	}

	.nowmark {
		position: absolute;
		top: -5px;
		width: 16px;
		height: 16px;
		margin-left: -8px;
		border-radius: 50%;
		background: var(--color-brand);
		/* A ring of tile colour, not a shadow */
		outline: 3px solid var(--color-tile);
	}

	.dl {
		position: relative;
		height: 11px;
		margin-top: 9px;
		font: 500 10.5px/1 var(--font-mono);
		color: var(--color-faint);
	}

	.dl span {
		position: absolute;
		translate: -50% 0;
		white-space: nowrap;
	}
</style>
