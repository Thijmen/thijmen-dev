---
/**
 * Mono kicker over a page title: `$ ls -lt blog/ | wc -l → 8`. In a hero
 * it types itself on load (styles below), then shows `out` (counting up
 * when `count`). The full text is always in the DOM, so screen readers,
 * copy and no-JS never see the effect. Kickers longer than 34 characters
 * don't type (they'd outgrow a phone); they rise with the hero instead.
 */
interface Props {
	cmd: string;
	out?: string | number;
	/** Count `out` up from 0 once it appears (scripts/motion.ts). */
	count?: boolean;
	/** Leave a blinking block cursor after the command. */
	cursor?: boolean;
}

const { cmd, out, count = false, cursor = false } = Astro.props;
const n = [...`$ ${cmd}`].length;
const typed = n <= 34;
---

<span class:list={["kicker", { "has-cursor": cursor }]} data-type={typed ? "" : undefined} style={`--n:${n}`}>
	<span class="type-text"><span class="sigil">$</span> {cmd}</span>{
		out !== undefined && (
			<>
				{" "}
				<span class="type-out">→ {count ? <span data-count>{out}</span> : out}</span>
			</>
		)
	}{cursor && <span class="cursor" />}
</span>

<style>
	.type-out {
		color: var(--color-text);
	}

	/*
	 * Typing: the command is revealed one character per step with
	 * clip-path (monospace, so 1ch per character), and a caret walks
	 * along in the same steps. Delayed by the hero stagger (--hero-i).
	 */
	.kicker[data-type] {
		--t0: calc(var(--hero-i, 0) * var(--stagger));
		--t1: calc(var(--t0) + var(--n) * var(--type-char));
		position: relative;
	}

	.type-text {
		display: inline-block;
		white-space: nowrap;
	}

	:global(:root[data-motion="full"]) [data-type] .type-text {
		animation: k-type calc(var(--n) * var(--type-char)) steps(var(--n)) var(--t0) backwards;
	}

	:global(:root[data-motion="full"]) [data-type]:not(.has-cursor)::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.55em;
		height: 1.05em;
		margin-top: -0.55em;
		background: var(--color-brand);
		opacity: 0;
		translate: calc(var(--n) * 1ch) 0;
		/* Walks with the text, lingers a beat, then goes. */
		animation:
			k-caret calc(var(--n) * var(--type-char)) steps(var(--n)) var(--t0) backwards,
			k-show calc(var(--t1) + 250ms) linear;
		pointer-events: none;
	}

	/* The persistent cursor is the caret: it walks in, then blinks. */
	:global(:root[data-motion="full"]) [data-type] .cursor {
		animation:
			k-caret-own calc(var(--n) * var(--type-char)) steps(var(--n)) var(--t0) backwards,
			blink 1.1s steps(1) var(--t1) infinite;
	}

	:global(:root[data-motion]) [data-type] .type-out {
		animation: m-fade 240ms ease-out calc(var(--t1) + 80ms) backwards;
	}

	@keyframes k-type {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0);
		}
	}

	@keyframes k-caret {
		from {
			translate: 0 0;
		}
		to {
			translate: calc(var(--n) * 1ch) 0;
		}
	}

	@keyframes k-show {
		from {
			opacity: 1;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes k-caret-own {
		from {
			translate: calc(var(--n) * -1ch - 6px) 0;
		}
		to {
			translate: 0 0;
		}
	}
</style>
