---
interface Props {
	name: string;
	email?: string;
	github?: string;
	linkedin?: string;
}

const { name, email, github, linkedin } = Astro.props;
---

<footer class="site-footer">
	<div class="inner">
		<span>© {new Date().getFullYear()} {name}</span>
		<div class="links">
			{github && <a href={github}>GitHub</a>}
			{linkedin && <a href={linkedin}>LinkedIn</a>}
			{email && <a href={`mailto:${email}`}>Email</a>}
		</div>
		<span class="keys">press <kbd>t</kbd> for theme · <kbd>⌘K</kbd> for everything</span>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		font-size: 13.5px;
		color: var(--color-faint);
	}

	.inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 32px var(--gutter);
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		align-items: center;
		justify-content: space-between;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
	}

	.links a {
		color: var(--color-muted);
	}

	.keys {
		font-family: var(--font-mono);
		font-size: 12px;
	}

	kbd {
		font: inherit;
		color: var(--color-text);
	}
</style>
