---
/**
 * Shared frame for a block: an optional mono section label over the content.
 * `narrow` caps the width at the reading measure used by post bodies.
 */
import SectionLabel from "../SectionLabel.astro";

interface Props {
	label?: string | null;
	note?: string;
	narrow?: boolean;
	/** Fade up on scroll as one unit. Off for blocks whose grid staggers itself. */
	reveal?: boolean;
}

const { label, note, narrow = false, reveal = true } = Astro.props;
---

<section class:list={["block", { narrow }]} data-reveal={reveal ? "" : undefined}>
	{label && <SectionLabel label={label} note={note} rule />}
	<slot />
</section>

<style>
	.block {
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-width: 0;
	}

	.narrow {
		max-width: 700px;
	}
</style>
