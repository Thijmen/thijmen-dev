---
import { Image } from "emdash/ui";
import { hasImage } from "../../lib/content";

interface Props {
	value: { image: unknown; caption?: string | null; width?: string | null };
}

const { value } = Astro.props;
---

{
	hasImage(value.image) && (
		<figure class:list={["figure", value.width === "wide" ? "wide" : "normal"]}>
			<div class="frame">
				<Image image={value.image as any} />
			</div>
			{value.caption && <figcaption>{value.caption}</figcaption>}
		</figure>
	)
}

<style>
	.figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.normal {
		max-width: 700px;
	}

	.frame {
		overflow: hidden;
		border-radius: var(--radius-xl);
		border: 1px solid var(--color-border);
	}

	.frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}
</style>
