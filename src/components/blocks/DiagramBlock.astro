---
import CodeBlock from "../pt/CodeBlock.astro";
import BlockSection from "./BlockSection.astro";

interface Props {
	value: { title?: string | null; code: string; caption?: string | null };
}

const { value } = Astro.props;
---

<BlockSection narrow>
	<CodeBlock node={{ code: value.code, language: "mermaid", filename: value.title ?? undefined, caption: value.caption ?? undefined }} />
</BlockSection>
