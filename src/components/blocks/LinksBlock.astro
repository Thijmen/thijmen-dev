---
import { sanitizeHref } from "emdash";
import BlockSection from "./BlockSection.astro";

interface Props {
	value: { label?: string | null; items?: Array<{ title: string; url: string; meta?: string | null }> | null };
}

const { value } = Astro.props;
const items = value.items ?? [];
---

{
	items.length > 0 && (
		<BlockSection label={value.label} narrow>
			<ul class="links">
				{items.map((l) => (
					<li>
						<a href={sanitizeHref(l.url)} class="link">
							<span class="title">{l.title}</span>
							{l.meta && <span class="meta">{l.meta}</span>}
							<span class="arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</BlockSection>
	)
}

<style>
	.links {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
	}

	.link {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 16px;
		padding: 14px 0;
		border-bottom: 1px dashed var(--color-border);
		color: var(--color-text);
		text-decoration: none;
	}

	li:last-child .link {
		border-bottom: 0;
	}

	.title {
		flex: 1 1 240px;
		font-family: var(--font-heading);
		font-size: 21px;
		line-height: 1.3;
	}

	.link:hover .title {
		color: var(--color-brand);
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.arrow {
		font-family: var(--font-mono);
		color: var(--color-muted);
	}

	.link:hover .arrow {
		color: var(--color-brand);
	}
</style>
