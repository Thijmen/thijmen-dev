---
/**
 * Open-source project card. `full` (projects page) shows the screenshot,
 * status, install command and stars; `compact` (home) is name + blurb + lang.
 */
import { Image } from "emdash/ui";
import { hasImage } from "../lib/content";

export interface Project {
	title: string;
	summary?: string;
	featured_image?: unknown;
	language?: string;
	project_status?: string;
	stars?: string;
	install?: string;
	url?: string;
}

interface Props {
	project: Project;
	variant?: "full" | "compact";
	showImage?: boolean;
}

const { project: p, variant = "full", showImage = true } = Astro.props;
const status = (p.project_status ?? "active").toLowerCase();
---

{
	variant === "compact" ? (
		<a href="/projects" class="card compact">
			<span class="name">{p.title}</span>
			{p.summary && <span class="desc">{p.summary}</span>}
			{p.language && <span class="lang">● {p.language}</span>}
		</a>
	) : (
		<article class="card hoverable full">
			{showImage && (
				<div class="shot">
					{hasImage(p.featured_image) ? (
						<Image image={p.featured_image as any} class="cover-img" />
					) : (
						<span class="shot-empty">{p.title}.png</span>
					)}
				</div>
			)}
			<div class="body">
				<div class="head">
					{p.url ? (
						<a href={p.url} class="name">
							{p.title}
						</a>
					) : (
						<span class="name">{p.title}</span>
					)}
					<span class:list={["status", status]}>{status}</span>
				</div>
				{p.summary && <div class="blurb">{p.summary}</div>}
				{p.install && (
					<div class="install">
						<span class="sigil">$</span> {p.install}
					</div>
				)}
				<div class="foot">
					{p.language && <span>● {p.language}</span>}
					{p.stars && <span>★ {p.stars}</span>}
				</div>
			</div>
		</article>
	)
}

<style>
	.name {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-brand);
	}

	/* Compact ------------------------------------------------------------- */
	.compact {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 22px;
	}

	.compact .name {
		font-size: 13px;
	}

	.desc {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.lang {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-muted);
	}

	/* Full ---------------------------------------------------------------- */
	.full {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 20px;
	}

	.shot {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.shot-empty {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 24px 26px 26px;
	}

	.head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
	}

	.full .name {
		font-size: 16px;
	}

	.status {
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		font-family: var(--font-mono);
		font-size: 11px;
		background: var(--color-surface);
		color: var(--color-muted);
	}

	.status.active {
		background: var(--color-brand-soft);
		color: var(--color-brand);
	}

	.status.maintained {
		color: var(--syntax-string);
	}

	.blurb {
		flex: 1;
		font-family: var(--font-heading);
		font-size: 22px;
		line-height: 1.3;
		text-wrap: pretty;
	}

	.install {
		overflow-x: auto;
		white-space: nowrap;
		padding: 10px 12px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.sigil {
		color: var(--color-brand);
	}

	.foot {
		display: flex;
		gap: 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}
</style>
