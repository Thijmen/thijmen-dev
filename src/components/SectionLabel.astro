---
/** Small plain section label ("Writing") with an optional right-hand link or note. */
interface Props {
	label: string;
	href?: string;
	linkText?: string;
	note?: string;
	rule?: boolean;
}

const { label, href, linkText, note, rule = false } = Astro.props;
---

<div class:list={["section-label", { rule }]} data-reveal>
	<span class="label">{label}</span>
	{href && <a href={href}>{linkText}</a>}
	{note && <span class="note">{note}</span>}
</div>

<style>
	.section-label {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		font-size: 13px;
		color: var(--color-faint);
	}

	.section-label a {
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--color-muted);
	}

	.section-label a:hover {
		color: var(--color-brand);
	}

	/* The rule is a background so it can draw in when the label reveals. */
	.rule {
		padding-bottom: 12px;
		background: linear-gradient(var(--color-border), var(--color-border)) left bottom / 100% 1px no-repeat;
	}

	:global(:root[data-motion="full"]) .rule {
		transition: background-size 900ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 120ms);
	}

	@media screen {
		:global(:root[data-motion="full"]) .rule:not(:global(.is-in)) {
			background-size: 0% 1px;
		}
	}

	.label {
		font-weight: 500;
		color: var(--color-faint);
	}

	.note {
		color: var(--color-muted);
	}
</style>
