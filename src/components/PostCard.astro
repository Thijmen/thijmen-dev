---
/**
 * Post tile in four shapes (all plain fills, no outlines):
 *  - latest:  tile-sized block, big cover on top, then meta, title, excerpt (home)
 *  - row:     a plain row for lists inside a tile: thumb, title, meta, read time
 *  - feature: wide tile, cover beside the text (blog index, latest post)
 *  - grid:    blog index grid tile
 * Posts without an uploaded image get a generated halftone cover.
 */
import { Image } from "emdash/ui";
import Cover from "./Cover.astro";
import { vtKey, type PostSummary } from "../lib/content";

interface Props {
	post: PostSummary;
	variant?: "latest" | "row" | "feature" | "grid";
	/** Legacy: `feature` used to be stacked unless `wide`. It is now always wide. */
	wide?: boolean;
}

// Anything else (data-reveal, …) lands on the root link.
const { post, variant = "grid", wide: _wide, ...attrs } = Astro.props;
const tags = post.tags.map((t) => t.slug);
// Cover + title morph into the post page when this card is clicked (motion.ts).
const vt = vtKey("post", post.slug);
const coverVariant = variant === "row" ? "thumb" : variant === "grid" ? "card" : "hero";
---

<Fragment>
	{
		variant === "row" ? (
			<a href={post.url} class="post-row" data-vt={vt} {...attrs}>
				<span class="thumb" data-vt-part="cover">
					{post.image ? (
						<Image image={post.image as any} class="cover-img" />
					) : (
						<Cover slug={post.slug} tags={tags} variant="thumb" />
					)}
				</span>
				<span class="row-text">
					<span class="row-title" data-vt-part="title" set:html={post.titleHtml} />
					<span class="meta">
						{post.date}
						{tags.map((t) => (
							<>
								<span class="sep">·</span>
								<span class="tag">#{t}</span>
							</>
						))}
					</span>
				</span>
				<span class="row-min">{post.readMin} min</span>
			</a>
		) : (
			<a href={post.url} class:list={["tile", `v-${variant}`]} data-vt={vt} {...attrs}>
				<div class="cover" data-vt-part="cover">
					{post.image ? (
						<Image image={post.image as any} class="cover-img" />
					) : (
						<Cover slug={post.slug} tags={tags} variant={coverVariant} />
					)}
					{(variant === "latest" || variant === "feature") && <span class="badge">Latest post</span>}
					{variant !== "grid" && (
						<span class="go" aria-hidden="true">
							<svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M3.5 9.5l6-6M4.5 3.5h5v5" />
							</svg>
						</span>
					)}
				</div>
				<div class="body">
					<span class="meta">
						{post.date}
						<span class="sep">·</span>
						{post.readMin} min
						{post.tag && (
							<>
								<span class="sep">·</span>
								<span class="tag">#{post.tag}</span>
							</>
						)}
					</span>
					<span class="title" data-vt-part="title" set:html={post.titleHtml} />
					{post.excerpt && <span class="excerpt">{post.excerpt}</span>}
				</div>
			</a>
		)
	}
</Fragment>

<style>
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-faint);
	}

	.sep {
		opacity: 0.5;
	}

	.tag {
		color: var(--color-brand);
	}

	.title,
	.row-title {
		font-family: var(--font-heading);
		font-weight: 400;
		text-wrap: pretty;
	}

	.title :global(em),
	.row-title :global(em) {
		font-style: italic;
		color: var(--color-brand);
	}

	.excerpt {
		font-size: 16px;
		line-height: 1.55;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	/* Tiles: latest, feature, grid -------------------------------------- */
	.tile {
		padding: 0;
	}

	.cover {
		position: relative;
		overflow: hidden;
		background: var(--color-surface);
	}

	.cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.badge {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 1;
		padding: 7px 12px;
		border-radius: var(--radius-pill);
		background: var(--color-tile);
		color: var(--color-text);
		font-size: 13px;
		font-weight: 500;
		line-height: 1;
	}

	.cover .go {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 1;
		background: var(--color-tile);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 26px 28px 30px;
	}

	/* latest: fills the grid cell; the cover takes what the text leaves */
	.v-latest {
		height: 100%;
	}

	.v-latest .cover {
		flex: 1;
		min-height: 260px;
	}

	.v-latest .title {
		font-size: 34px;
		line-height: 1.1;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	/* feature: cover beside the text */
	.v-feature {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		border-radius: var(--radius-xl);
	}

	.v-feature .cover {
		min-height: 320px;
	}

	.v-feature .body {
		justify-content: center;
		gap: 14px;
		padding: clamp(28px, 4vw, 48px);
	}

	.v-feature .title {
		font-size: clamp(32px, 3.6vw, 44px);
		line-height: 1.06;
		letter-spacing: -0.015em;
	}

	.v-feature .excerpt {
		font-size: 17px;
	}

	/* grid */
	.v-grid .cover {
		aspect-ratio: 16 / 9;
	}

	.v-grid .body {
		flex: 1;
		padding: 22px 24px 26px;
	}

	.v-grid .title {
		font-size: 24px;
		line-height: 1.18;
	}

	.v-grid .excerpt {
		flex: 1;
		font-size: 15px;
		line-height: 1.5;
	}

	/* Row: no chrome, so it sits inside any tile ------------------------ */
	.post-row {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) auto;
		gap: 16px;
		align-items: center;
		padding: 12px 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.post-row + .post-row {
		border-top: 1px solid var(--color-border);
	}

	.post-row:hover {
		text-decoration: none;
	}

	.thumb {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--color-surface);
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.row-text {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}

	.row-title {
		font-size: 21px;
		line-height: 1.2;
	}

	.row-min {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-faint);
		white-space: nowrap;
	}

	@media (hover: hover) and (pointer: fine) {
		.post-row:hover .row-title {
			color: var(--color-brand);
		}
	}

	@media (max-width: 520px) {
		.post-row {
			grid-template-columns: 48px minmax(0, 1fr);
		}

		.row-min {
			display: none;
		}
	}
</style>
