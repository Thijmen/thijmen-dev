---
/**
 * Code / terminal tile: a fixed-dark surface (dark in both themes) with a
 * filename tab, an optional right-hand slot ("aside") and the body. Used
 * for terminal blocks, code blocks and skills.yml.
 */
interface Props {
	title: string;
	class?: string;
	style?: string;
	size?: "sm" | "md";
}

// Anything else (data-print, data-hero-item, …) lands on the root.
const { title, class: className, size = "sm", ...attrs } = Astro.props;
---

<div class:list={["window", size, className]} {...attrs}>
	<div class="window-bar">
		<span class="window-title">{title}</span>
		<slot name="aside" />
	</div>
	<slot />
</div>

<style>
	.window {
		min-width: 0;
		overflow: hidden;
		background: var(--dark-tile);
		color: var(--dark-ink);
		border-radius: var(--radius-md);
		font-family: var(--font-mono);
		/* Dark surface in both themes: use the dark-mode syntax colours. */
		--syntax-keyword: oklch(0.77 0.14 295);
		--syntax-string: oklch(0.8 0.13 150);
		--syntax-fn: oklch(0.78 0.11 230);
		--syntax-comment: oklch(0.62 0.03 295);
		--syntax-number: oklch(0.8 0.12 60);
		--color-text: var(--dark-ink);
		--color-muted: var(--dark-ink-2);
	}

	.window.md {
		border-radius: var(--radius-lg);
	}

	.window-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 18px;
		background: var(--dark-tile-2);
		font-size: 12px;
		color: var(--dark-ink-2);
	}

	.window-title {
		flex: 1;
		font-size: 11.5px;
		font-weight: 600;
		color: var(--dark-ink);
	}

	.md .window-title {
		font-size: 12px;
	}
</style>
