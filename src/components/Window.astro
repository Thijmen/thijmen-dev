---
/**
 * Terminal window chrome: three dots, a filename, optional right-hand
 * slot ("aside"), then the body. Used for ~/.profile, skills.yml and code.
 */
interface Props {
	title: string;
	class?: string;
	size?: "sm" | "md";
}

const { title, class: className, size = "sm" } = Astro.props;
---

<div class:list={["window", size, className]}>
	<div class="window-bar">
		<span class="dot"></span><span class="dot"></span><span class="dot"></span>
		<span class="window-title">{title}</span>
		<slot name="aside" />
	</div>
	<slot />
</div>

<style>
	.window {
		min-width: 0;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		font-family: var(--font-mono);
	}

	.window.md {
		border-radius: var(--radius-xl);
	}

	.window-bar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px 16px;
		border-bottom: 1px solid var(--color-border);
		font-size: 12px;
		color: var(--color-muted);
	}

	.dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-border);
	}

	.window-title {
		flex: 1;
		margin-left: 8px;
		font-size: 11px;
	}

	.md .window-title {
		font-size: 12px;
	}
</style>
