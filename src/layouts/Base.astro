---
import { getEmDashCollection, getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getProfile, plainTitle } from "../lib/content";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	/** Side of the soft accent glow behind the page top. */
	glow?: "left" | "right";
}

const { title, description, image, type = "website", glow = "right" } = Astro.props;

const [settings, menu, { profile, cacheHint: profileHint }, { entries: latest, cacheHint: latestHint }] =
	await Promise.all([
		getSiteSettings(),
		getMenu("primary"),
		getProfile(),
		getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 1 }),
	]);

if (Astro.cache?.enabled) {
	if (profileHint) Astro.cache.set(profileHint);
	Astro.cache.set(latestHint);
}

const siteTitle = settings?.title || "Thijmen Stavenuiter";
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || "";
const nav = (menu?.items ?? []).map((i) => ({ label: i.label, url: i.url }));
const latestPost = latest[0] ? { title: plainTitle(latest[0].data.title), url: `/blog/${latest[0].id}` } : undefined;
const contact = {
	email: profile?.email,
	github: profile?.github_url,
	linkedin: profile?.linkedin_url,
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<script is:inline>
			// Apply the stored theme before paint; fall back to the OS preference.
			try {
				document.documentElement.dataset.theme =
					localStorage.getItem("ts-theme") ||
					(matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
			} catch (e) {}
		</script>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-heading" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" preload />
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS Feed`} href="/rss.xml" />
	</head>
	<body>
		<div class="shell">
			<div class:list={["glow", glow]} aria-hidden="true"></div>
			<SiteHeader nav={nav} latestPost={latestPost} {...contact} />
			<slot />
			<SiteFooter name={siteTitle} {...contact} />
		</div>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
				}

				[hidden] {
					display: none !important;
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					margin: 0;
					font-family: var(--font-body);
					background: var(--color-bg);
					color: var(--color-text);
					-webkit-font-smoothing: antialiased;
					transition:
						background-color 0.2s,
						color 0.2s;
				}

				a {
					color: var(--color-brand);
					text-decoration: none;
				}

				a:hover {
					text-decoration: underline;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}

				@keyframes blink {
					0%,
					50% {
						opacity: 1;
					}
					50.01%,
					100% {
						opacity: 0;
					}
				}
			}
		</style>

		<style>
			.shell {
				position: relative;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				overflow-x: clip;
			}

			.glow {
				position: absolute;
				top: -260px;
				width: 760px;
				height: 560px;
				background: radial-gradient(closest-side, var(--color-brand-soft), transparent);
				pointer-events: none;
			}

			.glow.right {
				right: -120px;
			}

			.glow.left {
				left: -160px;
			}

			@media print {
				.glow {
					display: none;
				}
			}
		</style>
	</body>
</html>
