---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getProfile, plainTitle } from "../lib/content";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/motion.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	/** Side of the soft accent glow behind the page top. */
	glow?: "left" | "right";
}

const { title, description, image, type = "website", glow = "right" } = Astro.props;

const [
	{ data: settings, cacheHint: settingsHint },
	{ data: menu, cacheHint: menuHint },
	{ profile, cacheHint: profileHint },
	{ entries: latest, cacheHint: latestHint },
] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getProfile(),
	getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 1 }),
]);

// Every page shows the header and footer, so every page carries their tags:
// editing the menu, site settings or profile purges the whole site.
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsHint);
	Astro.cache.set(menuHint);
	if (profileHint) Astro.cache.set(profileHint);
	Astro.cache.set(latestHint);
}

const siteTitle = settings?.title || "Thijmen Stavenuiter";
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || "";
const nav = (menu?.items ?? []).map((i) => ({ label: i.label, url: i.url }));
const latestPost = latest[0] ? { title: plainTitle(latest[0].data.title), url: `/blog/${latest[0].id}` } : undefined;
const contact = {
	email: profile?.email,
	github: profile?.github_url,
	linkedin: profile?.linkedin_url,
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#faf9fc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#100e17" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			(function () {
				var r = document.documentElement;
				var get = function (k) {
					try {
						return localStorage.getItem(k);
					} catch (e) {
						return null;
					}
				};
				// Apply the stored theme before paint; fall back to the OS preference.
				r.dataset.theme = get("ts-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				// Motion flag (see styles/motion.css). If scripts/motion.ts never runs,
				// drop it again so nothing stays hidden.
				r.dataset.motion =
					matchMedia("(prefers-reduced-motion: reduce)").matches || get("ts-motion") === "off" ? "reduced" : "full";
				addEventListener("DOMContentLoaded", function () {
					if (!r.hasAttribute("data-motion-ready")) r.removeAttribute("data-motion");
				});
				// Arriving through a card → page view transition (motion.ts sets the
				// key on pageswap): name this page's cover and title so they morph.
				addEventListener("pagereveal", function (e) {
					try {
						if (e.viewTransition && sessionStorage.getItem("vt-morph") === location.pathname) r.classList.add("vt-morph");
						sessionStorage.removeItem("vt-morph");
					} catch (err) {}
				});
			})();
		</script>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-heading" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" preload />
	</head>
	<body>
		<div class="shell">
			<div class:list={["glow", glow]} aria-hidden="true"></div>
			<SiteHeader nav={nav} latestPost={latestPost} {...contact} />
			<slot />
			<SiteFooter name={siteTitle} {...contact} />
		</div>

		<script>
			import "../scripts/motion";
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
				}

				[hidden] {
					display: none !important;
				}

				html {
					scrollbar-gutter: stable;
					/* Set by SiteHeader once it sticks. */
					scroll-padding-top: var(--header-offset, 0px);
				}

				:root[data-motion="full"] {
					scroll-behavior: smooth;
				}

				body {
					margin: 0;
					font-family: var(--font-body);
					background: var(--color-bg);
					color: var(--color-text);
					-webkit-font-smoothing: antialiased;
					transition:
						background-color 0.2s,
						color 0.2s;
				}

				a {
					color: var(--color-brand);
					text-decoration: none;
				}

				a:hover {
					text-decoration: underline;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				:focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}

				@keyframes blink {
					0%,
					50% {
						opacity: 1;
					}
					50.01%,
					100% {
						opacity: 0;
					}
				}
			}
		</style>

		<style>
			.shell {
				position: relative;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				overflow-x: clip;
			}

			.glow {
				position: absolute;
				top: -260px;
				width: 760px;
				height: 560px;
				background: radial-gradient(closest-side, var(--color-brand-soft), transparent);
				pointer-events: none;
			}

			.glow.right {
				right: -120px;
			}

			.glow.left {
				left: -160px;
			}

			/* Breathes: a slow drift, alternating so it never visibly loops. */
			:global(:root[data-motion="full"]) .glow {
				animation: glow-drift 24s ease-in-out infinite alternate;
			}

			:global(:root[data-motion="full"]) .glow.left {
				animation-direction: alternate-reverse;
			}

			@keyframes glow-drift {
				0% {
					translate: 0 0;
					scale: 1;
				}
				50% {
					translate: -40px 24px;
					scale: 1.08;
					opacity: 0.85;
				}
				100% {
					translate: 32px -16px;
					scale: 0.95;
				}
			}

			@media print {
				.glow {
					display: none;
				}
			}
		</style>
	</body>
</html>
