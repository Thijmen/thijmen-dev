---
/**
 * Project case study: the card's fields as a header, then the `body` blocks.
 * Cards only link here when the project has blocks (see projectHref()).
 */
import { decodeSlug, getEmDashEntry, sanitizeHref } from "emdash";
import { Blocks, Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { MissingBlock, projectBody } from "../../components/blocks";
import { hasImage } from "../../lib/content";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: project, cacheHint } = await getEmDashEntry("projects", slug);
if (!project) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const d = project.data;
const status = (d.project_status ?? "active").toLowerCase();
const coverSrc = hasImage(d.featured_image) ? (d.featured_image as { src?: string }).src : undefined;
---

<Base title={d.title} description={d.summary} image={coverSrc} glow="left">
	<main class="page project">
		<header class="hero">
			<a href="/projects" class="chip back">← cd ../projects</a>
			<span class="kicker"><span class="sigil">$</span> cat {d.title}/README.md</span>
			<h1 class="display name">{d.title}</h1>
			{d.summary && <p class="lede">{d.summary}</p>}
			<div class="meta">
				<span class:list={["pill", "status", status]}>{status}</span>
				{d.language && <span class="pill">● {d.language}</span>}
				{d.stars && <span class="pill">★ {d.stars}</span>}
				{d.url && <a href={sanitizeHref(d.url)} class="pill repo">source ↗</a>}
			</div>
			{d.install && (
				<div class="install">
					<span class="sigil">$</span> {d.install}
				</div>
			)}
		</header>

		{
			coverSrc && (
				<div class="cover">
					<Image image={d.featured_image as any} class="cover-img" priority />
				</div>
			)
		}

		<div class="body">
			<Blocks value={d.body} components={projectBody} fallback={MissingBlock} />
		</div>
	</main>
</Base>

<style>
	.back {
		align-self: flex-start;
		padding: 6px 12px;
	}

	.name {
		font-family: var(--font-mono);
		font-size: clamp(40px, 6vw, 68px);
		letter-spacing: -0.04em;
		overflow-wrap: anywhere;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.pill {
		padding: 5px 11px;
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: inherit;
		text-decoration: none;
	}

	a.pill:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.status.active {
		background: var(--color-brand-soft);
		border-color: transparent;
		color: var(--color-brand);
	}

	.status.maintained {
		color: var(--syntax-string);
	}

	.install {
		overflow-x: auto;
		white-space: nowrap;
		padding: 10px 12px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-muted);
	}

	.sigil {
		color: var(--color-brand);
	}

	.cover {
		aspect-ratio: 21 / 9;
		overflow: hidden;
		border-radius: var(--radius-xl);
		border: 1px solid var(--color-border);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 56px;
	}
</style>
