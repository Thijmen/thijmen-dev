---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Kicker from "../../components/Kicker.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProfile, plainTitle, projectHref, riseWords } from "../../lib/content";

const [{ profile, cacheHint: profileHint }, { entries, cacheHint }] = await Promise.all([
	getProfile(),
	getEmDashCollection("projects", { orderBy: { position: "asc" } }),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (profileHint) Astro.cache.set(profileHint);
}
const projectsTitle = profile?.projects_title || "Projects *& open source.*";
---

<Base title="Projects" description={profile?.projects_intro} glow="left">
	<main class="page">
		<div class="hero" data-hero>
			<Kicker cmd="ls -la projects/" />
			<h1
				class="display"
				data-words
				aria-label={plainTitle(projectsTitle)}
				set:html={riseWords(projectsTitle)}
			/>
			{profile?.projects_intro && <p class="lede">{profile.projects_intro}</p>}
		</div>

		{
			entries.length > 0 ? (
				<div class="grid" data-stagger>
					{entries.map((e) => (
						<ProjectCard project={e.data as any} href={projectHref(e)} />
					))}
				</div>
			) : (
				<p class="lede">Nothing here yet.</p>
			)
		}
	</main>
</Base>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: 20px;
	}
</style>
