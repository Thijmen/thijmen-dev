---
import { decodeSlug, getEmDashCollection, getEmDashEntry } from "emdash";
import { Blocks, Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { MissingBlock, postSections } from "../../components/blocks";
import { ptComponents } from "../../components/pt/components";
import {
	extractHeadings,
	formatDate,
	hasImage,
	plainTitle,
	readingTime,
	riseWords,
	vtKey,
} from "../../lib/content";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const [{ entry: post, cacheHint }, { entries: all, cacheHint: listHint }] = await Promise.all([
	getEmDashEntry("posts", slug),
	getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 200 }),
]);

if (!post) return Astro.redirect("/404");

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(listHint);
}

const d = post.data;
const title = plainTitle(d.title);
const tags: Array<{ slug: string }> = (d as any).terms?.tag ?? [];
const headings = extractHeadings(d.content);

// Neighbours in date order: the list is newest first.
const index = all.findIndex((e) => e.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const coverSrc = hasImage(d.featured_image) ? (d.featured_image as any).src : undefined;
// Morph targets for the card → post view transition (styles/motion.css).
const vt = vtKey("post", post.id);
---

<Base title={title} description={d.excerpt} image={coverSrc} type="article" glow="right">
	<div class="progress" aria-hidden="true"></div>
	<main class="page post">
		<header class="post-head" data-hero>
			<a href="/blog" class="chip back">← cd ../blog</a>
			<h1 class="title vt-title" style={`--vt-name:${vt}-title`} data-words aria-label={title} set:html={riseWords(d.title)} />
			<div class="meta">
				<span class="pill">{formatDate(d.date)}</span>
				<span class="pill">{readingTime(d.content)} min read</span>
				{
					tags.map((t) => (
						<a href={`/blog?tag=${t.slug}`} class="tag-soft">
							#{t.slug}
						</a>
					))
				}
			</div>
		</header>

		<figure class="cover" data-hero-item style="--hero-i:3">
			<div class:list={["cover-frame", "vt-cover", { placeholder: !coverSrc }]} style={`--vt-name:${vt}-cover`}>
				{coverSrc ? <Image image={d.featured_image as any} class="cover-img" priority /> : <span>cover.png · 2100×900</span>}
			</div>
			{d.cover_caption && <figcaption>{d.cover_caption}</figcaption>}
		</figure>

		<div class="layout">
			<article class="article">
				<div class="prose">
					<PortableText value={d.content} components={ptComponents as any} />
				</div>

				<Blocks value={d.sections} components={postSections} fallback={MissingBlock} />

				{
					(older || newer) && (
						<nav class="neighbours" aria-label="More posts" data-stagger>
							{older ? (
								<a href={`/blog/${older.id}`} class="card neighbour">
									<span class="dir">← older</span>
									<span class="n-title">{plainTitle(older.data.title)}</span>
								</a>
							) : (
								<span />
							)}
							{newer && (
								<a href={`/blog/${newer.id}`} class="card neighbour right">
									<span class="dir">newer →</span>
									<span class="n-title">{plainTitle(newer.data.title)}</span>
								</a>
							)}
						</nav>
					)
				}
			</article>

			<aside class="card toc" data-reveal>
				{
					headings.length > 0 && (
						<>
							<div class="toc-label">CONTENTS</div>
							<nav class="toc-links">
								<span class="toc-glide" aria-hidden="true" />
								{headings.map((h) => (
									<a href={`#${h.id}`}>{h.text}</a>
								))}
							</nav>
						</>
					)
				}
				<div class="toc-actions">
					<button type="button" class="mini" data-copy-link>copy link</button>
				</div>
			</aside>
		</div>
	</main>
</Base>

<script>
	// Reading progress: a scroll-driven animation where supported (CSS
	// below); otherwise this listener scales the bar.
	const bar = document.querySelector<HTMLElement>(".progress");
	const scrollDriven = CSS.supports("animation-timeline: scroll()");
	const progress = () => {
		const h = document.documentElement.scrollHeight - innerHeight;
		if (bar) bar.style.transform = `scaleX(${h > 0 ? Math.min(1, scrollY / h) : 0})`;
	};

	// CONTENTS scrollspy: highlight the section being read; the highlight
	// slides between entries.
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-links a")];
	const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
	const glide = document.querySelector<HTMLElement>(".toc-glide");
	let active = -2;
	function spy() {
		const line = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-offset")) || 0) + 80;
		let i = -1;
		heads.forEach((h, k) => h && h.getBoundingClientRect().top <= line && (i = k));
		if (heads.length && innerHeight + scrollY >= document.documentElement.scrollHeight - 2) i = heads.length - 1;
		if (i === active) return;
		const jump = active < 0;
		active = i;
		links.forEach((a, k) => {
			a.classList.toggle("is-active", k === i);
			if (k === i) a.setAttribute("aria-current", "true");
			else a.removeAttribute("aria-current");
		});
		const a = links[i];
		if (!glide) return;
		if (!a) return glide.classList.remove("on");
		if (jump) glide.style.transition = "none";
		glide.style.setProperty("--x", `${a.offsetLeft}px`);
		glide.style.setProperty("--y", `${a.offsetTop}px`);
		glide.style.setProperty("--w", `${a.offsetWidth}px`);
		glide.style.setProperty("--h", `${a.offsetHeight}px`);
		if (jump) {
			void glide.offsetWidth;
			glide.style.transition = "";
		}
		glide.classList.add("on");
	}

	let ticking = false;
	addEventListener(
		"scroll",
		() => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				if (!scrollDriven) progress();
				spy();
			});
		},
		{ passive: true },
	);
	if (!scrollDriven) progress();
	spy();

	document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", (e) => {
		const btn = e.currentTarget as HTMLButtonElement;
		navigator.clipboard?.writeText(location.href).catch(() => {});
		btn.textContent = "copied ✓";
		setTimeout(() => (btn.textContent = "copy link"), 1400);
	});
</script>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 25;
		width: 100%;
		height: 3px;
		background: var(--color-brand);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	@supports (animation-timeline: scroll()) {
		.progress {
			animation-name: progress-grow;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root block);
		}
	}

	@keyframes progress-grow {
		to {
			transform: scaleX(1);
		}
	}

	@media print {
		.progress {
			display: none;
		}
	}

	.post {
		padding-top: clamp(40px, 6vw, 72px);
	}

	.post-head {
		display: flex;
		flex-direction: column;
		gap: 22px;
		max-width: 920px;
	}

	.back {
		align-self: flex-start;
		padding: 6px 12px;
	}

	.title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(44px, 6vw, 76px);
		line-height: 1.02;
		font-weight: 400;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.title :global(em) {
		font-style: italic;
		color: var(--color-brand);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.pill {
		padding: 5px 11px;
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.cover {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.cover-frame {
		width: 100%;
		aspect-ratio: 21 / 9;
		overflow: hidden;
		border-radius: var(--radius-xl);
		border: 1px solid var(--color-border);
		font-size: 13px;
	}

	figcaption {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.layout {
		display: flex;
		flex-wrap: wrap-reverse;
		gap: 48px 72px;
		align-items: flex-start;
	}

	.article {
		flex: 1 1 560px;
		max-width: 700px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 56px;
	}

	/* Prose (shared rules in components.css) ----------------------------- */
	.prose > :global(p:first-child) {
		font-size: 24px;
		line-height: 1.55;
	}

	/* Neighbours ----------------------------------------------------------- */
	.neighbours {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: 16px;
	}

	.neighbour {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 20px 22px;
		border-radius: var(--radius-lg);
	}

	.neighbour.right {
		text-align: right;
	}

	.dir {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}

	.n-title {
		font-family: var(--font-heading);
		font-size: 21px;
		line-height: 1.25;
	}

	/* Contents aside ------------------------------------------------------- */
	.toc {
		flex: 0 1 260px;
		/* The row is wrap-reverse, so flex-end is the top edge. */
		align-self: flex-end;
		position: sticky;
		top: calc(var(--header-offset, 0px) + 24px);
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 22px;
		font-size: 14px;
	}

	.toc-label {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--color-brand);
	}

	.toc-links {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.toc-links a {
		position: relative;
		margin: 0 -10px;
		padding: 6px 10px;
		border-radius: var(--radius-sm);
		color: var(--color-text);
		transition: color var(--dur-fast);
	}

	.toc-links a.is-active {
		color: var(--color-brand);
	}

	.toc-glide {
		position: absolute;
		top: 0;
		left: 0;
		width: var(--w, 0);
		height: var(--h, 0);
		translate: var(--x, 0) var(--y, 0);
		border-radius: var(--radius-sm);
		background: var(--color-brand-soft);
		opacity: 0;
		transition:
			translate var(--dur-move) var(--ease-out),
			height var(--dur-move) var(--ease-out),
			opacity var(--dur-fast);
	}

	.toc-glide:global(.on) {
		opacity: 1;
	}

	.toc-links a:hover {
		background: var(--color-surface);
		text-decoration: none;
	}

	.toc-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding-top: 12px;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.mini {
		padding: 5px 10px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
	}

	.mini:hover {
		border-color: var(--color-brand);
		text-decoration: none;
	}

	@media (max-width: 959px) {
		.toc {
			position: static;
		}
	}
</style>
