---
import { decodeSlug, getEmDashCollection, getEmDashEntry } from "emdash";
import { Blocks, Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import { MissingBlock, postSections } from "../../components/blocks";
import { ptComponents } from "../../components/pt/components";
import {
	emphasize,
	extractHeadings,
	formatDate,
	getProfile,
	hasImage,
	plainTitle,
	readingTime,
	riseWords,
	toPostSummary,
	vtKey,
} from "../../lib/content";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const [{ entry: post, cacheHint }, { entries: all, cacheHint: listHint }, { profile, cacheHint: profileHint }] = await Promise.all([
	getEmDashEntry("posts", slug),
	getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 200 }),
	getProfile(),
]);

if (!post) return Astro.redirect("/404");

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(listHint);
	if (profileHint) Astro.cache.set(profileHint);
}

const d = post.data;
const title = plainTitle(d.title);
const tags: Array<{ slug: string }> = (d as any).terms?.tag ?? [];
const headings = extractHeadings(d.content);

// Neighbours in date order: the list is newest first.
const index = all.findIndex((e) => e.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

// Media uploaded through the admin is stored without `src` (the Image
// component resolves it), so render on hasImage(); `src` only feeds og:image.
const hasCover = hasImage(d.featured_image);
const readMin = readingTime(d.content);
const tagSlugs = tags.map((t) => t.slug);

// Related: other posts sharing a tag, newest first.
const related = all
	.filter((e) => e.id !== post.id && ((e.data as any).terms?.tag ?? []).some((t: { slug: string }) => tagSlugs.includes(t.slug)))
	.slice(0, 3)
	.map(toPostSummary);
const olderPost = older ? toPostSummary(older) : undefined;
const newerPost = newer ? toPostSummary(newer) : undefined;

// A post-specific CTA lives in `sections` (a cta block); without one, fall back to the profile's.
const hasSectionCta = Array.isArray(d.sections) && d.sections.some((b: any) => b?._type === "cta");
const cta = !hasSectionCta && profile?.email && profile?.cta_home ? { text: profile.cta_home, email: profile.email } : undefined;
const coverSrc = hasCover ? (d.featured_image as any).src : undefined;
// Morph targets for the card → post view transition (styles/motion.css).
const vt = vtKey("post", post.id);
---
<Base title={title} description={d.excerpt} image={coverSrc} type="article">
	<div class="progress" aria-hidden="true"></div>
	<main class="page post">
		<header class="tile post-head" data-hero>
			<div class="txt">
				<a href="/blog" class="back">← All posts</a>
				<h1 class="title vt-title" style={`--vt-name:${vt}-title`} data-words aria-label={title} set:html={riseWords(d.title)} />
				{d.excerpt && <p class="lede">{d.excerpt}</p>}
				<div class="meta">
					<time>{formatDate(d.date)}</time>
					<span class="sep">·</span>
					<span>{readMin} min read</span>
					{
						tags.length > 0 && <span class="sep">·</span>
					}
					{
						tags.map((t) => (
							<a href={`/blog?tag=${t.slug}`} class="tag">
								#{t.slug}
							</a>
						))
					}
				</div>
			</div>
			<figure class="cover vt-cover" style={`--vt-name:${vt}-cover`} data-hero-item style="--hero-i:3">
				{
					hasCover ? (
						<Image image={d.featured_image as any} class="cover-img" priority />
					) : (
						<Cover slug={post.id} tags={tagSlugs} variant="hero" />
					)
				}
				{d.cover_caption && <figcaption class="cap">{d.cover_caption}</figcaption>}
			</figure>
		</header>

		<div class="layout">
			<article class="article">
				<div class="prose">
					<PortableText value={d.content} components={ptComponents as any} />
				</div>

				<Blocks value={d.sections} components={postSections} fallback={MissingBlock} />

				{
					cta && (
						<a href={`mailto:${cta.email}`} class="tile field cta">
							<span class="cta-text" set:html={emphasize(cta.text)} />
							<span class="cta-mail">{cta.email} →</span>
						</a>
					)
				}
			</article>

			<aside class="rail">
				{
					headings.length > 0 && (
						<nav class="tile toc" aria-label="Contents" data-read-min={readMin}>
							<div class="tile-label">Contents</div>
							<div class="toc-links">
								<span class="toc-glide" aria-hidden="true" />
								{headings.map((h, i) => (
									<a href={`#${h.id}`}>
										<span class="n">{String(i + 1).padStart(2, "0")}</span>
										<span>{h.text}</span>
									</a>
								))}
							</div>
							<div class="read">
								<span class="bar">
									<i />
								</span>
								<span class="left">{readMin} min left</span>
							</div>
						</nav>
					)
				}
				{
					related.length > 0 && (
						<section class="tile related">
							<div class="tile-label">Related</div>
							<div class="related-list">
								{related.map((r) => (
									<a href={r.url}>
										<span class="thumb">
											{r.image ? <Image image={r.image as any} class="cover-img" /> : <Cover slug={r.slug} tags={r.tags.map((t) => t.slug)} variant="thumb" />}
										</span>
										<span>
											<span class="t" set:html={r.titleHtml} />
											<span class="d">{r.date}</span>
										</span>
									</a>
								))}
							</div>
						</section>
					)
				}
				<button type="button" class="tile copy" data-copy-link>
					<span class="copy-label">Copy link</span>
					<span class="go" aria-hidden="true">
						<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5.5 8.5l3-3M6 3.5l.8-.8a2.5 2.5 0 013.5 3.5l-.8.8M8 10.5l-.8.8a2.5 2.5 0 01-3.5-3.5l.8-.8" />
						</svg>
					</span>
				</button>
			</aside>
		</div>

		{
			(olderPost || newerPost) && (
				<nav class="neighbours" aria-label="More posts" data-stagger>
					{[
						{ p: olderPost, dir: "← Older" },
						{ p: newerPost, dir: "Newer →" },
					].map(
						({ p, dir }) =>
							p && (
								<a href={p.url} class="tile neighbour">
									<div class="tile-label">
										<span>{dir}</span>
										<span class="go" aria-hidden="true">
											<svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
												<path d="M3.5 9.5l6-6M4.5 3.5h5v5" />
											</svg>
										</span>
									</div>
									<span class="n-thumb">
										{p.image ? <Image image={p.image as any} class="cover-img" /> : <Cover slug={p.slug} tags={p.tags.map((t) => t.slug)} variant="hero" />}
									</span>
									<span class="n-title" set:html={p.titleHtml} />
									<span class="n-meta">
										{p.date}
										{p.tag && (
											<>
												<span class="sep">·</span>
												<span class="tag">#{p.tag}</span>
											</>
										)}
									</span>
								</a>
							),
					)}
				</nav>
			)
		}
	</main>
</Base>

<script>
	// Reading progress: a scroll-driven animation where supported (CSS
	// below); otherwise this listener scales the bar.
	const bar = document.querySelector<HTMLElement>(".progress");
	const scrollDriven = CSS.supports("animation-timeline: scroll()");
	const progress = () => {
		const h = document.documentElement.scrollHeight - innerHeight;
		if (bar) bar.style.transform = `scaleX(${h > 0 ? Math.min(1, scrollY / h) : 0})`;
	};

	// CONTENTS scrollspy: highlight the section being read; the highlight
	// slides between entries.
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-links a")];
	const toc = document.querySelector<HTMLElement>(".toc");
	const readBar = toc?.querySelector<HTMLElement>(".read i");
	const readLeft = toc?.querySelector<HTMLElement>(".read .left");
	const readMin = Number(toc?.dataset.readMin ?? 0);
	// How far through the article the reader is: the bar and "N min left".
	function readProgress() {
		const art = document.querySelector<HTMLElement>(".article");
		if (!art || !readBar || !readLeft) return;
		const r = art.getBoundingClientRect();
		const p = Math.max(0, Math.min(1, (innerHeight * 0.6 - r.top) / r.height));
		readBar.style.width = `${Math.round(p * 100)}%`;
		const left = Math.ceil(readMin * (1 - p));
		readLeft.textContent = p >= 0.98 ? "done" : `${Math.max(left, 1)} min left`;
	}
	const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
	const glide = document.querySelector<HTMLElement>(".toc-glide");
	let active = -2;
	function spy() {
		const line = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-offset")) || 0) + 80;
		let i = -1;
		heads.forEach((h, k) => h && h.getBoundingClientRect().top <= line && (i = k));
		if (heads.length && innerHeight + scrollY >= document.documentElement.scrollHeight - 2) i = heads.length - 1;
		if (i === active) return;
		const jump = active < 0;
		active = i;
		links.forEach((a, k) => {
			a.classList.toggle("is-active", k === i);
			if (k === i) a.setAttribute("aria-current", "true");
			else a.removeAttribute("aria-current");
		});
		const a = links[i];
		if (!glide) return;
		if (!a) return glide.classList.remove("on");
		if (jump) glide.style.transition = "none";
		glide.style.setProperty("--x", `${a.offsetLeft}px`);
		glide.style.setProperty("--y", `${a.offsetTop}px`);
		glide.style.setProperty("--w", `${a.offsetWidth}px`);
		glide.style.setProperty("--h", `${a.offsetHeight}px`);
		if (jump) {
			void glide.offsetWidth;
			glide.style.transition = "";
		}
		glide.classList.add("on");
	}

	let ticking = false;
	addEventListener(
		"scroll",
		() => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				if (!scrollDriven) progress();
				spy();
				readProgress();
			});
		},
		{ passive: true },
	);
	if (!scrollDriven) progress();
	spy();
	readProgress();

	document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", (e) => {
		const btn = e.currentTarget as HTMLButtonElement;
		navigator.clipboard?.writeText(location.href).catch(() => {});
		const label = btn.querySelector<HTMLElement>(".copy-label") ?? btn;
		label.textContent = "Copied ✓";
		setTimeout(() => (label.textContent = "Copy link"), 1400);
	});
</script>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 25;
		width: 100%;
		height: 3px;
		background: var(--color-brand);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	@supports (animation-timeline: scroll()) {
		.progress {
			animation-name: progress-grow;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root block);
		}
	}

	@keyframes progress-grow {
		to {
			transform: scaleX(1);
		}
	}

	@media print {
		.progress {
			display: none;
		}
	}

	.post {
		padding-top: 8px;
		gap: 48px;
	}

	/* Header tile: text left, cover right ---------------------------------- */
	.post-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 46%;
		min-height: 440px;
		padding: 0;
	}

	.txt {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(28px, 4vw, 44px) clamp(24px, 4vw, 48px) clamp(26px, 3.4vw, 40px);
	}

	.back {
		font-size: 14px;
		color: var(--color-faint);
	}

	.back:hover {
		color: var(--color-text);
		text-decoration: none;
	}

	.title {
		margin: 30px 0 0;
		font-family: var(--font-heading);
		font-size: clamp(38px, 4.6vw, 58px);
		line-height: 1;
		font-weight: 450;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.title :global(em) {
		font-style: italic;
		color: var(--color-brand);
	}

	.lede {
		margin: 22px 0 0;
		max-width: 30em;
		font-size: 18.5px;
		line-height: 1.5;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.meta {
		margin-top: auto;
		padding-top: 28px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-faint);
	}

	.sep {
		opacity: 0.5;
	}

	.tag {
		color: var(--color-brand);
	}

	.cover {
		position: relative;
		margin: 0;
		min-height: 260px;
		overflow: hidden;
		background: var(--color-surface);
	}

	.cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cap {
		position: absolute;
		left: 18px;
		bottom: 18px;
		z-index: 1;
		max-width: calc(100% - 36px);
		padding: 8px 12px;
		border-radius: var(--radius-sm);
		background: var(--color-tile);
		font-size: 13px;
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.post-head {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.cover {
			order: -1;
			aspect-ratio: 16 / 9;
		}
	}

	/* Body + rail ------------------------------------------------------------ */
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 296px;
		gap: 48px 56px;
		align-items: start;
	}

	.article {
		min-width: 0;
		max-width: 700px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	@media (min-width: 1100px) {
		/* Room on the left for the hanging h2 numerals. */
		.article {
			margin-left: 76px;
		}
	}

	/* Prose (shared rules in components.css) */
	.prose {
		counter-reset: sec;
		font-size: 20.5px;
		line-height: 1.66;
		gap: 22px;
	}

	.prose > :global(p:first-child) {
		font-size: 22px;
		line-height: 1.6;
	}

	.prose :global(h2) {
		position: relative;
		margin: 28px 0 -4px;
		font-family: var(--font-body);
		font-size: 27px;
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.03em;
		counter-increment: sec;
	}

	.prose :global(h2::before) {
		content: counter(sec, decimal-leading-zero);
		display: block;
		margin-bottom: 6px;
		font-size: 14px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-brand);
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 1100px) {
		.prose :global(h2::before) {
			position: absolute;
			right: calc(100% + 20px);
			top: -2px;
			margin: 0;
			font-size: 32px;
			line-height: 1;
			letter-spacing: -0.05em;
		}
	}

	.prose :global(p code),
	.prose :global(li code) {
		background: var(--color-tile);
		color: var(--color-brand);
		border: 0;
	}

	/* TL;DR: the list after an h2 "TL;DR" becomes a tile with big numerals. */
	.prose :global(h2[id^="tl-dr"] + ul),
	.prose :global(h2[id^="tl-dr"] + ol) {
		counter-reset: tl;
		margin: 0;
		padding: 10px 28px;
		list-style: none;
		gap: 0;
		border-radius: var(--radius-lg);
		background: var(--color-tile);
	}

	.prose :global(h2[id^="tl-dr"] + ul > li),
	.prose :global(h2[id^="tl-dr"] + ol > li) {
		counter-increment: tl;
		display: grid;
		grid-template-columns: 48px 1fr;
		align-items: baseline;
		padding: 14px 0;
		font-size: 19px;
		line-height: 1.45;
	}

	.prose :global(h2[id^="tl-dr"] + ul > li + li),
	.prose :global(h2[id^="tl-dr"] + ol > li + li) {
		border-top: 1px solid var(--color-border);
	}

	.prose :global(h2[id^="tl-dr"] + ul > li::before),
	.prose :global(h2[id^="tl-dr"] + ol > li::before) {
		content: counter(tl);
		font-family: var(--font-body);
		font-size: 34px;
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: var(--color-brand);
		font-variant-numeric: tabular-nums;
	}

	/* Fallback CTA (no cta block in sections) */
	.cta {
		gap: 20px;
		text-decoration: none;
	}

	.cta:hover {
		text-decoration: none;
	}

	.cta-text {
		font-family: var(--font-heading);
		font-size: 27px;
		line-height: 1.15;
		text-wrap: balance;
	}

	.cta-text :global(em) {
		color: oklch(0.9 0.06 300);
	}

	.cta-mail {
		align-self: flex-start;
		padding: 11px 16px;
		border-radius: var(--radius-pill);
		background: var(--color-on-field);
		color: var(--color-field);
		font-size: 13.5px;
		font-weight: 600;
	}

	/* Rail ------------------------------------------------------------------ */
	.rail {
		position: sticky;
		top: calc(var(--header-offset, 0px) + 16px);
		display: flex;
		flex-direction: column;
		gap: var(--gap);
	}

	.rail .tile {
		padding: 22px 22px 20px;
		border-radius: 20px;
	}

	.toc-links {
		position: relative;
		margin-top: 6px;
		display: flex;
		flex-direction: column;
	}

	.toc-links a {
		position: relative;
		display: grid;
		grid-template-columns: 30px 1fr;
		margin: 0 -10px;
		padding: 7px 10px;
		border-radius: var(--radius-sm);
		font-size: 14.5px;
		line-height: 1.35;
		color: var(--color-muted);
		transition: color var(--dur-fast);
	}

	.toc-links a .n {
		font-size: 13px;
		font-weight: 600;
		line-height: 1.5;
		color: var(--color-faint);
		font-variant-numeric: tabular-nums;
	}

	.toc-links a.is-active {
		color: var(--color-text);
	}

	.toc-links a.is-active .n {
		color: var(--color-brand);
	}

	.toc-links a:hover {
		text-decoration: none;
		color: var(--color-text);
	}

	.toc-glide {
		position: absolute;
		top: 0;
		left: 0;
		width: var(--w, 0);
		height: var(--h, 0);
		translate: var(--x, 0) var(--y, 0);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		opacity: 0;
		transition:
			translate var(--dur-move) var(--ease-out),
			height var(--dur-move) var(--ease-out),
			opacity var(--dur-fast);
	}

	.toc-glide:global(.on) {
		opacity: 1;
	}

	.read {
		margin-top: 14px;
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-faint);
	}

	.read .bar {
		flex: 1;
		height: 4px;
		border-radius: 2px;
		background: var(--color-surface);
	}

	.read i {
		display: block;
		width: 0;
		height: 100%;
		border-radius: 2px;
		background: var(--color-brand);
	}

	.related-list {
		margin-top: 6px;
		display: flex;
		flex-direction: column;
	}

	.related-list a {
		display: grid;
		grid-template-columns: 44px 1fr;
		gap: 12px;
		align-items: center;
		padding: 8px 0;
		color: var(--color-text);
	}

	.related-list a + a {
		border-top: 1px solid var(--color-border);
	}

	.related-list a:hover {
		text-decoration: none;
	}

	.thumb {
		position: relative;
		width: 44px;
		height: 44px;
		overflow: hidden;
		border-radius: 11px;
		background: var(--color-surface);
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.related-list .t {
		display: block;
		font-family: var(--font-heading);
		font-size: 16.5px;
		line-height: 1.22;
	}

	.related-list .t :global(em) {
		font-style: italic;
		color: var(--color-brand);
	}

	.related-list .d {
		display: block;
		margin-top: 4px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--color-faint);
	}

	.copy {
