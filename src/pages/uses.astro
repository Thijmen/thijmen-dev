---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { emphasize, getProfile, hasImage } from "../lib/content";
import Soundtrack from "../components/Soundtrack.astro";

const byPosition = { orderBy: { position: "asc" as const } };
const [{ profile, cacheHint: profileHint }, toolsRes, deskRes] = await Promise.all([
	getProfile(),
	getEmDashCollection("tools", byPosition),
	getEmDashCollection("desk_items", byPosition),
]);

if (Astro.cache?.enabled) {
	if (profileHint) Astro.cache.set(profileHint);
	for (const r of [toolsRes, deskRes]) Astro.cache.set(r.cacheHint);
}

const tools = toolsRes.entries.map((e) => e.data);
const categories = [...new Set(tools.map((t) => t.category).filter(Boolean))] as string[];
const desk = deskRes.entries.map((e) => e.data);
---

<Base title="Uses" description={profile?.uses_intro} glow="right">
	<main class="page uses">
		<div class="hero">
			<span class="kicker"><span class="sigil">$</span> jq . uses.json</span>
			<h1 class="display" set:html={emphasize(profile?.uses_title || "Uses*.json*")} />
			{profile?.uses_intro && <p class="lede">{profile.uses_intro}</p>}
		</div>

		<Soundtrack note={profile?.soundtrack_note || undefined} />

		{
			tools.length > 0 && (
				<section class="section">
					<SectionLabel label="TOOLS" note={`ls ~/.local/bin | wc -l → ${tools.length}`} rule />
					<div class="chip-row" data-tool-filter>
						<button type="button" class="chip" data-cat="all" aria-pressed="true">
							all <span class="count">{tools.length}</span>
						</button>
						{categories.map((c) => (
							<button type="button" class="chip" data-cat={c} aria-pressed="false">
								{c} <span class="count">{tools.filter((t) => t.category === c).length}</span>
							</button>
						))}
					</div>
					<div class="tools">
						{tools.map((t) => (
							<div class="card hoverable tool" data-tool-cat={t.category}>
								<div class="tool-head">
									<span class="glyph">{t.glyph}</span>
									<span class="tool-cat">{t.category}</span>
								</div>
								<div class="tool-text">
									<span class="tool-name">{t.title}</span>
									{t.why && <span class="tool-why">{t.why}</span>}
								</div>
							</div>
						))}
					</div>
				</section>
			)
		}

		{
			desk.length > 0 && (
				<section class="section">
					<SectionLabel label="DESK" rule />
					<div class="desk">
						<div class:list={["desk-photo", { placeholder: !hasImage(profile?.desk_photo) }]}>
							{hasImage(profile?.desk_photo) ? (
								<Image image={profile!.desk_photo as any} class="cover-img" />
							) : (
								<span>desk.jpg</span>
							)}
						</div>
						<div class="card desk-list">
							{desk.map((d) => (
								<div class="desk-item">
									<span class="desk-k">{d.label}</span>
									<div class="desk-v">
										<span class="desk-name">{d.title}</span>
										{d.note && <span class="desk-note">{d.note}</span>}
									</div>
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}
	</main>
</Base>

<script>
	// Tool category filter.
	const filter = document.querySelector<HTMLElement>("[data-tool-filter]");
	if (filter) {
		const chips = [...filter.querySelectorAll<HTMLButtonElement>("[data-cat]")];
		const cards = [...document.querySelectorAll<HTMLElement>("[data-tool-cat]")];
		chips.forEach((chip) =>
			chip.addEventListener("click", () => {
				const cat = chip.dataset.cat;
				chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
				cards.forEach((card) => (card.hidden = cat !== "all" && card.dataset.toolCat !== cat));
			}),
		);
	}
</script>

<style>
	.uses {
		gap: 64px;
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	/* Tools --------------------------------------------------------------- */
	.tools {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
		gap: 16px;
	}

	.tool {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 20px;
	}

	.tool-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 10px;
	}

	.glyph {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 11px;
		background: var(--color-brand-soft);
		color: var(--color-brand);
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 700;
	}

	.tool-cat {
		padding: 3px 9px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-muted);
	}

	.tool-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.tool-name {
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
	}

	.tool-why {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	/* Desk ---------------------------------------------------------------- */
	.desk {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
		gap: 20px;
		align-items: start;
	}

	.desk-photo {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 20px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.desk-list {
		display: flex;
		flex-direction: column;
		padding: 6px 24px;
		border-radius: 20px;
	}

	.desk-item {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 18px;
		align-items: baseline;
		padding: 16px 0;
		border-bottom: 1px dashed var(--color-border);
	}

	.desk-item:last-child {
		border-bottom: 0;
	}

	.desk-k {
		flex: 0 0 100px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--syntax-keyword);
	}

	.desk-v {
		flex: 1 1 200px;
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.desk-name {
		font-family: var(--font-heading);
		font-size: 21px;
		line-height: 1.3;
	}

	.desk-note {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-muted);
	}
</style>
