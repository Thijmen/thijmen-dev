---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Kicker from "../components/Kicker.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Timeline from "../components/Timeline.astro";
import Window from "../components/Window.astro";
import { asArray, emphasize, getProfile, langHue, projectHref, riseWords } from "../lib/content";

const [settings, { profile, cacheHint: profileHint }, rolesRes, postsRes, projectsRes] = await Promise.all([
	getSiteSettings(),
	getProfile(),
	getEmDashCollection("roles", { orderBy: { position: "asc" } }),
	getEmDashCollection("posts", { limit: 200 }),
	getEmDashCollection("projects", { orderBy: { position: "asc" }, limit: 50 }),
]);

if (Astro.cache?.enabled) {
	if (profileHint) Astro.cache.set(profileHint);
	Astro.cache.set(rolesRes.cacheHint);
	Astro.cache.set(postsRes.cacheHint);
	Astro.cache.set(projectsRes.cacheHint);
}

const name = settings?.title || "Thijmen Stavenuiter";
const roles = rolesRes.entries.map((e) => e.data);
const postCount = postsRes.entries.length;
const skills = asArray<{ k: string; items: string[] | string }>(profile?.skills);
// A few projects for the sidebar: featured ones first, then by position.
const projects = [...projectsRes.entries]
	.sort((a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured)))
	.slice(0, 4)
	.map((e) => ({ data: e.data, href: projectHref(e) ?? e.data.url ?? "/projects" }));
const projectCount = projectsRes.entries.length;
const email = profile?.email;
const bare = (url?: string) => url?.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<Base title="Resume" description={profile?.resume_intro} glow="right">
	<main class="page resume">
		<header class="head">
			<div class="head-row">
				<div class="hero" data-hero>
					<Kicker cmd="cat resume.yml" />
					<h1 class="display" data-words aria-label={name} set:html={riseWords(name)} />
					{profile?.status_line && <span class="role">{profile.status_line}</span>}
				</div>
				<div class="actions" data-hero-item style="--hero-i:3">
					<button type="button" class="btn btn-primary" data-print>Download PDF ↓</button>
					{email && <a href={`mailto:${email}`} class="btn">Get in touch</a>}
				</div>
			</div>
		</header>

		<div class="layout">
			<section class="card history" data-reveal>
				<SectionLabel label="History" note="git log --stat" />
				<Timeline roles={roles as any} variant="full" />
			</section>

			<aside class="side" data-stagger>
				{
					skills.length > 0 && (
						<Window title="skills.yml" class="skills" data-print style={`--lines:${skills.length}`}>
							<div class="skills-body">
								{skills.map((s, i) => (
									<div data-line style={`--line:${i}`}>
										<span class="k">{s.k}</span>: [
										<span class="s">{Array.isArray(s.items) ? s.items.join(", ") : s.items}</span>]
									</div>
								))}
							</div>
						</Window>
					)
				}
				{
					projects.length > 0 && (
						<section class="card projects">
							<div class="label">Open source</div>
							<ul class="proj-list">
								{projects.map((p) => (
									<li>
										<a href={p.href} class="proj">
											<span class="proj-name">{p.data.title}</span>
											{p.data.summary && <span class="proj-desc">{p.data.summary}</span>}
											{p.data.language && (
												<span class="proj-lang">
													<i style={`--lc:${langHue(p.data.language)}`} />
													{p.data.language}
												</span>
											)}
										</a>
									</li>
								))}
							</ul>
							{projectCount > projects.length && (
								<a href="/projects" class="proj-all">
									All <span data-count>{projectCount}</span> projects →
								</a>
							)}
						</section>
					)
				}
				<div class="card speaking">
					<div class="label">Speaking &amp; writing</div>
					<a href="/blog" class="posts-link">
						<span data-count>{postCount}</span> posts on this blog →
					</a>
					{profile?.speaking_note && <span class="muted">{profile.speaking_note}</span>}
				</div>
				<div class="accent-card contact">
					{profile?.cta_resume && <span class="contact-text" set:html={emphasize(profile.cta_resume)} />}
					<div class="contact-links">
						{email && <a href={`mailto:${email}`}>{email}</a>}
						{profile?.linkedin_url && <a href={profile.linkedin_url}>{bare(profile.linkedin_url)}</a>}
						{profile?.github_url && <a href={profile.github_url}>{bare(profile.github_url)}</a>}
					</div>
				</div>
			</aside>
		</div>
	</main>
</Base>

<script>
	document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

<style>
	.resume {
		gap: 56px;
	}

	.head {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.head-row {
		display: flex;
		flex-wrap: wrap;
		gap: 28px 48px;
		align-items: flex-end;
		justify-content: space-between;
	}

	.head .hero {
		gap: 14px;
		max-width: 820px;
	}

	.role {
		font-family: var(--font-heading);
		font-style: italic;
		font-size: clamp(24px, 2.6vw, 32px);
		color: var(--color-brand);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.layout {
		display: flex;
		flex-wrap: wrap;
		gap: var(--gap);
		align-items: flex-start;
	}

	.history {
		flex: 1 1 560px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: clamp(24px, 3vw, var(--pad));
	}

	.side {
		flex: 1 1 300px;
		max-width: 440px;
		display: flex;
		flex-direction: column;
		gap: var(--gap);
	}

	.side :global(.skills) {
		font-size: 13px;
		line-height: 1.9;
	}

	.skills-body {
		padding: 16px 20px 20px;
		overflow-wrap: anywhere;
	}

	.k {
		color: var(--syntax-keyword);
	}

	.s {
		color: var(--syntax-string);
	}

	.speaking {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: var(--pad);
	}

	.label {
		font-size: 13px;
		font-weight: 500;
		color: var(--color-faint);
	}

	.posts-link {
		font-family: var(--font-heading);
		font-size: 22px;
		color: var(--color-text);
	}

	.posts-link:hover {
		color: var(--color-brand);
		text-decoration: none;
	}

	.muted {
		font-size: 14px;
		color: var(--color-muted);
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: var(--pad);
	}

	.proj-list {
		display: flex;
		flex-direction: column;
		margin: 0 -12px;
		padding: 0;
		list-style: none;
	}

	.proj {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2px 12px;
		padding: 10px 12px;
		border-radius: var(--radius-md);
		color: var(--color-text);
		text-decoration: none;
		transition: background-color var(--dur-fast) var(--ease-out);
	}

	.proj-name {
		font-weight: 700;
		font-size: 15px;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.proj-desc {
		grid-column: 1 / -1;
		grid-row: 2;
		font-size: 13px;
		line-height: 1.4;
		color: var(--color-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.proj-lang {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-faint);
	}

	.proj-lang i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--lc);
	}

	.proj:hover {
		text-decoration: none;
	}

	.proj:hover .proj-name {
		color: var(--color-brand);
	}

	@media (hover: hover) and (pointer: fine) {
		.proj:hover {
			background: var(--color-surface);
		}
	}

	.proj-all {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-muted);
	}

	.proj-all:hover {
		color: var(--color-brand);
		text-decoration: none;
	}

	.contact {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: var(--pad);
	}

	.contact-text {
		font-family: var(--font-heading);
		font-size: 26px;
		line-height: 1.2;
	}

	.contact-links {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 13px;
	}

	@media print {
		:global(.site-header),
		:global(.site-footer),
		.actions {
			display: none;
		}

		.resume {
			padding: 0;
		}
	}
</style>
