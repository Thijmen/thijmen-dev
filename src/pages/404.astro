---
import Base from "../layouts/Base.astro";
import Kicker from "../components/Kicker.astro";
import { riseWords } from "../lib/content";

const path = Astro.url.pathname;
---

<Base title="Not found" glow="left">
	<main class="page">
		<div class="hero" data-hero>
			<Kicker cmd={`cd ${path}`} />
			<h1 class="display" data-words aria-label="404." set:html={riseWords("404*.*")} />
			<p class="lede">
				<span class="mono">cd: no such file or directory: {path}</span>
			</p>
			<p class="lede">It may have moved, or it never existed. Try <kbd>⌘K</kbd> or one of these:</p>
			<div class="links">
				<a href="/" class="btn btn-primary">cd ~</a>
				<a href="/blog" class="btn">ls blog/</a>
			</div>
		</div>
	</main>
</Base>

<style>
	.mono {
		font-size: 15px;
		overflow-wrap: anywhere;
	}

	kbd {
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--color-text);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 8px;
	}
</style>
