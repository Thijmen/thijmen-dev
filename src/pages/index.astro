---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Blocks } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Kicker from "../components/Kicker.astro";
import PostCard from "../components/PostCard.astro";
import Portrait from "../components/Portrait.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Timeline from "../components/Timeline.astro";
import Go from "../components/home/Go.astro";
import UsesTile from "../components/home/UsesTile.astro";
import { MissingBlock } from "../components/blocks";
import { homeTiles } from "../components/tiles";
import { asArray, emphasize, getProfile, hasImage, projectHref, riseWords, toPostSummary } from "../lib/content";

const [settings, { profile, cacheHint: profileHint }, postsRes, rolesRes, projectsRes] = await Promise.all([
	getSiteSettings(),
	getProfile(),
	// The whole (small) blog: the count comes from it, the tiles take the first six.
	getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 200 }),
	getEmDashCollection("roles", { orderBy: { position: "asc" }, limit: 3 }),
	getEmDashCollection("projects", { orderBy: { position: "asc" }, limit: 50 }),
]);

if (Astro.cache?.enabled) {
	if (profileHint) Astro.cache.set(profileHint);
	for (const r of [postsRes, rolesRes, projectsRes]) Astro.cache.set(r.cacheHint);
}

const name = settings?.title || "Thijmen Stavenuiter";
const [first, ...restNames] = name.split(" ");
const portrait = hasImage(profile?.portrait) ? profile!.portrait! : undefined;
const allPosts = postsRes.entries.map(toPostSummary);
const [latest, ...more] = allPosts;
const moreWriting = more.slice(0, 5);
const roles = rolesRes.entries.map((e) => e.data);
// Featured projects share one row: one, two or three tiles.
const featured = projectsRes.entries
	.filter((e) => e.data.featured)
	.slice(0, 3)
	.map((e) => ({ data: e.data, href: projectHref(e) }));
const email = profile?.email;
// "status" is one of the hero's ~/.profile lines in the CMS; it captions the photo.
const status = asArray<{ k: string; v: string }>(profile?.profile_lines).find((l) => l.k === "status")?.v;
---

<Base glow="right">
	<main class="home">
		<div class="bento">
			<section class:list={["tile", "intro", { solo: !portrait }]} data-hero>
				{profile?.status_line && <span class="status-pill">{profile.status_line}</span>}
				<h1
					class="name"
					data-words
					aria-label={`${first} ${restNames.join(" ")}.`}
					set:html={riseWords(`${first}\n${restNames.join(" ")}*.*`)}
				/>
				{profile?.hero_intro && <p class="lede">{profile.hero_intro}</p>}
				<div class="ctas">
					<a href="/blog" class="btn btn-primary">Read the blog <span aria-hidden="true">→</span></a>
					<a href="/resume" class="btn">Resume</a>
					<Kicker cmd={`man ${first.toLowerCase()}`} cursor />
				</div>
			</section>

			{
				portrait && (
					<Portrait image={portrait} alt={portrait.alt || name} class="area-portrait" data-hero-item style="--hero-i:3">
						{status && (
							<>
								Status: <b>{status}</b>
							</>
						)}
					</Portrait>
				)
			}

			{
				latest && (
					<div class:list={["area-latest", { solo: moreWriting.length === 0 }]} data-reveal>
						<PostCard post={latest} variant={moreWriting.length ? "latest" : "feature"} />
					</div>
				)
			}

			{
				moreWriting.length > 0 && (
					<section class="tile writing" data-reveal>
						<div class="tile-label">
							<span>More writing</span>
							<a href="/blog" class="count">
								<span class="big-num n">{allPosts.length}</span>posts <Go />
							</a>
						</div>
						<div class="rows">
							{moreWriting.map((p) => (
								<PostCard post={p} variant="row" />
							))}
						</div>
					</section>
				)
			}

			{featured.map((p) => <ProjectCard project={p.data as any} variant="tile" href={p.href} class={`area-project of-${featured.length}`} />)}

			{
				roles.length > 0 && (
					<a href="/resume" class="tile career" data-reveal>
						<div class="tile-label cmd">
							<span>
								<b>$</b> git log --oneline
							</span>
							<Go />
						</div>
						<Timeline roles={roles as any} variant="compact" />
					</a>
				)
			}

			<UsesTile />

			{
				email && (
					<a href={`mailto:${email}`} class="tile field contact" data-reveal>
						<div class="tile-label">
							<span>Say hello</span>
							<Go />
						</div>
						{profile?.cta_home && <p class="cta" set:html={emphasize(profile.cta_home)} />}
						<span class="mail">{email} →</span>
					</a>
				)
			}

			{/* Editor-made tiles (profile → Home tiles) flow in after the fixed ones. */}
			{profile?.tiles && <Blocks value={profile.tiles} components={homeTiles} fallback={MissingBlock} />}
		</div>
	</main>
</Base>

<style>
	.home {
		position: relative;
		width: 100%;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--gutter) 24px;
	}

	/* The bento: 12 columns, auto-placed in source order. Each tile spans a
	   fixed share of a row; below 1024px it is 6 columns, below 640px a single
	   column in reading order. `dense` lets a small CMS tile fill a gap a
	   missing tile left. */
	.bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-auto-rows: minmax(240px, auto);
		grid-auto-flow: row dense;
		gap: var(--gap);
	}

	.intro {
		grid-column: span 7;
		min-height: 500px;
	}
	.bento > :global(.area-portrait) {
		grid-column: span 5;
	}
	/* Without a portrait the intro takes the whole top row. */
	.intro.solo {
		grid-column: 1 / -1;
	}
	.area-latest {
		grid-column: span 5;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.area-latest.solo {
		grid-column: 1 / -1;
	}
	.area-latest > :global(.tile) {
		flex: 1;
	}
	.writing {
		grid-column: span 7;
	}
	.bento > :global(.area-project) {
		grid-column: span 6;
		min-height: 260px;
	}
	.bento > :global(.area-project.of-1) {
		grid-column: 1 / -1;
	}
	.bento > :global(.area-project.of-3) {
		grid-column: span 4;
	}
	.career {
		grid-column: span 5;
	}
	.bento > :global(.uses) {
		grid-column: span 4;
	}
	.contact {
		grid-column: span 3;
	}

	/* CMS tiles: HomeTile sets --span (of 12) and --tspan (of 6) from the block's width. */
	.bento > :global(.home-tile) {
		grid-column: span var(--span, 4);
	}
	.bento > :global(.home-tile.tall) {
		grid-row: span 2;
	}

	@media (max-width: 1023px) {
		.bento {
			grid-template-columns: repeat(6, minmax(0, 1fr));
			grid-auto-rows: auto;
		}

		.bento > :global(*) {
			grid-column: span 3 !important;
		}

		.intro,
		.area-latest,
		.writing,
		.career,
		.bento > :global(.area-project.of-1),
		.bento > :global(.area-project.of-3) {
			grid-column: span 6 !important;
		}

		.bento > :global(.home-tile) {
			grid-column: span var(--tspan, 3) !important;
			grid-row: auto;
		}

		.intro {
			order: -2;
			min-height: 0;
		}
		.bento > :global(.area-portrait) {
			order: -1;
			min-height: 420px;
		}
	}

	@media (max-width: 639px) {
		.bento > :global(*),
		.bento > :global(.home-tile) {
			grid-column: 1 / -1 !important;
		}
		.bento > :global(.area-portrait) {
			min-height: 360px;
		}
	}

	/* Intro ------------------------------------------------------------- */
	.intro {
		container-type: inline-size;
		padding: 36px 44px 40px;
	}

	.intro .status-pill {
		padding-left: 12px;
	}

	.name {
		margin: 34px 0 0 -5px;
		font-family: var(--font-body);
		font-weight: 800;
		font-size: clamp(46px, 15.4cqi, 106px);
		line-height: 0.86;
		letter-spacing: -0.058em;
	}

	.name :global(em) {
		font-style: normal;
		color: var(--color-brand);
	}

	.lede {
		margin: 26px 0 0;
		max-width: 26em;
		font-family: var(--font-heading);
		font-size: 22px;
		line-height: 1.4;
		letter-spacing: -0.005em;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.ctas {
		margin-top: auto;
		padding-top: 28px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}

	.ctas :global(.kicker) {
		margin-left: 14px;
	}

	@media (max-width: 639px) {
		.intro {
			padding: 28px 24px 28px;
		}
	}

	/* More writing --------------------------------------------------------- */
	.writing {
		padding-bottom: 16px;
	}

	.count {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--color-muted);
		text-decoration: none;
	}

	.count:hover {
		text-decoration: none;
	}

	.count .n {
		font-size: 30px;
		color: var(--color-text);
	}

	.rows {
		margin-top: 8px;
		display: flex;
		flex-direction: column;
	}

	/* Career ------------------------------------------------------------- */
	.career :global(.timeline) {
		margin-top: 14px;
	}

	/* Contact ------------------------------------------------------------ */
	.cta {
		margin: 16px 0 0;
		font-family: var(--font-heading);
		font-size: 27px;
		line-height: 1.12;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.cta :global(em) {
		font-style: italic;
		color: oklch(0.9 0.06 300);
	}

	.mail {
		margin-top: auto;
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		height: 38px;
		padding: 0 15px;
		border-radius: var(--radius-pill);
		background: var(--color-on-field);
		color: var(--color-field);
		font: 600 13.5px/1 var(--font-body);
	}
</style>
