---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Timeline from "../components/Timeline.astro";
import Window from "../components/Window.astro";
import { asArray, emphasize, getProfile, toPostSummary } from "../lib/content";

const [settings, { profile, cacheHint: profileHint }, postsRes, rolesRes, projectsRes] = await Promise.all([
	getSiteSettings(),
	getProfile(),
	getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 4 }),
	getEmDashCollection("roles", { orderBy: { position: "asc" }, limit: 3 }),
	// Booleans are stored as 0/1; `where` takes strings and SQLite coerces "1".
	getEmDashCollection("projects", { where: { featured: "1" }, orderBy: { position: "asc" }, limit: 2 }),
]);

if (Astro.cache?.enabled) {
	if (profileHint) Astro.cache.set(profileHint);
	for (const r of [postsRes, rolesRes, projectsRes]) Astro.cache.set(r.cacheHint);
}

const [first, ...restNames] = (settings?.title || "Thijmen Stavenuiter").split(" ");
const posts = postsRes.entries.map(toPostSummary);
const [feature, ...others] = posts;
const roles = rolesRes.entries.map((e) => e.data);
const projects = projectsRes.entries.map((e) => e.data);
const lines = asArray<{ k: string; v: string; kind?: string }>(profile?.profile_lines);
const email = profile?.email;
---

<Base glow="right">
	<main class="home">
		<section class="hero-grid">
			<div class="intro">
				{profile?.status_line && <span class="status-pill">{profile.status_line}</span>}
				<h1 class="name">{first}<br />{restNames.join(" ")}<em>.</em></h1>
				{profile?.hero_intro && <p class="tagline">{profile.hero_intro}</p>}
				<div class="ctas">
					<a href="/blog" class="btn btn-primary">Read the blog →</a>
					<a href="/resume" class="btn">Resume</a>
					<span class="kicker"><span class="sigil">$</span> man {first.toLowerCase()}<span class="cursor"></span></span>
				</div>
			</div>
			{
				lines.length > 0 && (
					<Window title="~/.profile" class="profile">
						<div class="profile-body">
							{lines.map((l) => (
								<div>
									<span class="k">{l.k}</span>=
									{l.kind === "list" ? (
										<>
											(<span class="s">{l.v}</span>)
										</>
									) : l.kind === "number" ? (
										<span class="n">{l.v}</span>
									) : (
										<span class="s">"{l.v}"</span>
									)}
								</div>
							))}
						</div>
					</Window>
				)
			}
		</section>

		{
			feature && (
				<section class="writing">
					<SectionLabel label="WRITING" href="/blog" linkText="ls blog/ →" rule />
					<div class="writing-grid">
						<PostCard post={feature} variant="feature" />
						<div class="rows">
							{others.map((p) => (
								<PostCard post={p} variant="row" />
							))}
						</div>
					</div>
				</section>
			)
		}

		<section class="split">
			{
				roles.length > 0 && (
					<div class="card history">
						<SectionLabel label="HISTORY" href="/resume" linkText="resume(7) →" />
						<Timeline roles={roles as any} variant="compact" />
					</div>
				)
			}
			<div class="side">
				{
					projects.length > 0 && (
						<div class="projects">
							{projects.map((p) => (
								<ProjectCard project={p as any} variant="compact" />
							))}
						</div>
					)
				}
				{
					email && (
						<a href={`mailto:${email}`} class="accent-card cta">
							{profile?.cta_home && <span class="cta-text" set:html={emphasize(profile.cta_home)} />}
							<span class="cta-mail">$ mail {email} →</span>
						</a>
					)
				}
			</div>
		</section>
	</main>
</Base>

<style>
	.home {
		position: relative;
		width: 100%;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--gutter);
		display: flex;
		flex-direction: column;
	}

	.hero-grid {
		padding: clamp(48px, 8vw, 88px) 0 80px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		gap: 48px 64px;
		align-items: end;
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 24px;
		min-width: 0;
	}

	.name {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(60px, 8.5vw, 96px);
		line-height: 0.96;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.name em {
		font-style: italic;
		color: var(--color-brand);
	}

	.tagline {
		margin: 0;
		max-width: 560px;
		font-size: 20px;
		line-height: 1.55;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 18px;
	}

	.hero-grid :global(.profile) {
		font-size: 13px;
		line-height: 1.95;
	}

	.profile-body {
		padding: 16px 22px 20px;
		overflow-wrap: anywhere;
	}

	.k {
		color: var(--syntax-keyword);
	}

	.s {
		color: var(--syntax-string);
	}

	.n {
		color: var(--syntax-number);
	}

	.writing {
		padding-bottom: 80px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.writing-grid,
	.split {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: 20px;
	}

	.rows {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.split {
		padding-bottom: 96px;
	}

	.history {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 26px 28px;
	}

	.side {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
		gap: 20px;
	}

	.cta {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 18px;
		padding: 26px 28px;
		text-decoration: none;
	}

	.cta:hover {
		text-decoration: none;
	}

	.cta-text {
		font-family: var(--font-heading);
		font-size: 30px;
		line-height: 1.2;
		text-wrap: balance;
	}

	.cta-mail {
		font-family: var(--font-mono);
		font-size: 13px;
	}
</style>
