{
  "name": "thijmen-dev",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:ai": "DEV_REMOTE_AI=1 node --env-file-if-exists=.env.access node_modules/astro/bin/astro.mjs dev",
    "build": "emdash seed --validate && astro build",
    "preview": "astro preview",
    "deploy:prod": "wrangler d1 time-travel info thijmen-dev && wrangler deploy",
    "deploy:preview": "wrangler preview",
    "migrate:status:prod": "emdash migrate --status --account-id 7dac805f31c2d6d9d0b73499d61513d2 --d1 d22c1ca4-cc2c-4e75-9873-b04459553df9",
    "migrate:status:preview": "emdash migrate --status --account-id 7dac805f31c2d6d9d0b73499d61513d2 --d1 db7c702c-16e0-4ae3-80e4-becfe7048d8a",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@thijmen/plugin-ai-writer": "workspace:*",
    "astro": "^7.3.2",
    "emdash": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35"
}
