{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thijmen-dev",
	"account_id": "7dac805f31c2d6d9d0b73499d61513d2",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thijmen-dev","database_id": "d22c1ca4-cc2c-4e75-9873-b04459553df9",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "thijmen-dev","preview_bucket_name": "thijmen-dev",
		},
	],
	"previews": {
		"vars": {
			"ENVIRONMENT": "preview",
			// TEMPORARY: lets the setup wizard run on the reset preview D1. Revert before merge.
			"EMDASH_SITE_URL": "https://emdash-blocks-thijmen-dev.thijmenstavenuiter.workers.dev"
		},
		"kv_namespaces": [
			{
				"binding": "SESSION", "id": "a2745f6cbd7248ba9c4770ce3e3ddd49"
			}
		],
		"d1_databases": [
			{
				"binding": "DB", "database_name": "thijmen-dev-preview", "database_id": "db7c702c-16e0-4ae3-80e4-becfe7048d8a"
			}
		],
		"r2_buckets": [
			{
				"binding": "MEDIA",
				"bucket_name": "thijmen-dev-preview","preview_bucket_name": "thijmen-dev-preview",
			}
		]
	},


	
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
