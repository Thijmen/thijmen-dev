{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thijmen-dev",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thijmen-dev","database_id": "d22c1ca4-cc2c-4e75-9873-b04459553df9",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "thijmen-dev","preview_bucket_name": "thijmen-dev",
		},
	],
	"previews": {
		"vars": {
			"ENVIRONMENT": "preview"
		},
		"kv_namespaces": [
			{
				"binding": "SESSION", "id": "a2745f6cbd7248ba9c4770ce3e3ddd49"
			}
		],
		"d1_databases": [
			{
				"binding": "DB", "database_name": "thijmen-dev-preview", "database_id": "db7c702c-16e0-4ae3-80e4-becfe7048d8a"
			}
		]
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
